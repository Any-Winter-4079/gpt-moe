@@ -5,6 +5,38 @@ from torch import Tensor
 from torch.library import custom_op
 
 
+@custom_op("gpt_moe::deepgemm_fp8_projection", mutates_args=())
+def grouped_fp8_projection(
+    x: Tensor, x_scale: Tensor, weight: Tensor, weight_scale: Tensor,
+    offsets: Tensor, dtype: torch.dtype,
+) -> Tensor:
+    # DeepGEMM b64107f with docker_build/cu134-deepgemm/deepgemm-sm120-fp32-output.patch
+    import deep_gemm
+
+    if torch.cuda.get_device_capability(x.device) != (12, 0):
+        raise ValueError("DeepGEMM grouped FP8 projections require SM120; select the triton backend on other GPUs")
+    if x.shape[1] % 128 or weight.shape[1] % 128:
+        raise ValueError("DeepGEMM grouped FP8 projections require widths divisible by 128")
+    if dtype not in (torch.float32, torch.bfloat16):
+        raise ValueError("DeepGEMM grouped FP8 projections require float32 or bfloat16 outputs")
+    out = torch.empty((x.shape[0], weight.shape[1]), device=x.device, dtype=dtype)
+    deep_gemm.m_grouped_fp8_gemm_nt_contiguous(
+        (x, x_scale), (weight, weight_scale), out, offsets,
+        recipe=(1, 1, 128), disable_ue8m0_cast=True,
+        use_psum_layout=True, ensure_zero_padding=False,
+        expected_m_for_psum_layout=x.shape[0] // offsets.numel(),
+    )
+    return out
+
+
+@grouped_fp8_projection.register_fake
+def _fake_grouped_fp8_projection(
+    x: Tensor, x_scale: Tensor, weight: Tensor, weight_scale: Tensor,
+    offsets: Tensor, dtype: torch.dtype,
+) -> Tensor:
+    return torch.empty((x.shape[0], weight.shape[1]), device=x.device, dtype=dtype)
+
+
