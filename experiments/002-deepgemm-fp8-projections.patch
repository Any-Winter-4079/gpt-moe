+def _unpad_projection_kernel(Padded, Out, Offsets, M: tl.constexpr, N: tl.constexpr, NUM_EXPERTS: tl.constexpr):
+    tile = tl.program_id(0)
+    col = tl.program_id(1) * 128 + tl.arange(0, 128)
+    start = 0
+    first_tile = 0
+    for expert in range(NUM_EXPERTS):
