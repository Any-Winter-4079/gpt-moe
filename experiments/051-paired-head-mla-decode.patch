+def _mla_decode_paired_step(
+    latent, rope, valid, q_latent, q_rope, query_bias, gain,
+    maximum, denominator, acc,
+    P: tl.constexpr, SCALE: tl.constexpr, SOFTCAP: tl.constexpr, BACKEND: tl.constexpr,
+):
+    score = tl.sum(latent * q_latent[None, :], axis=1) + query_bias
+    if P:
+        score += tl.sum(rope * q_rope[None, :], axis=1)
+    score = score * gain * SCALE
+    if SOFTCAP > 0.0:
+        if BACKEND == "clamp":
+            score = tl.where(score != score, score, tl.minimum(tl.maximum(score, -SOFTCAP), SOFTCAP))
+        elif BACKEND == "rational":
+            z = score / SOFTCAP
+            z = tl.where(z != z, z, tl.minimum(tl.maximum(z, -3.0), 3.0))
+            square = z * z
+            score = SOFTCAP * z * (27.0 + square) / (27.0 + 9.0 * square)
+        elif BACKEND == "ptx":
+            score = SOFTCAP * tl.inline_asm_elementwise(
+                "tanh.approx.f32 $0, $1;", constraints="=f,f",
+                args=[score / SOFTCAP], dtype=tl.float32, is_pure=True, pack=1,
+            )
+        else:
+            score = SOFTCAP * libdevice.tanh(score / SOFTCAP)
+    score = tl.where(valid, score * 1.4426950408889634, float("-inf"))
+    next_maximum = tl.maximum(maximum, tl.max(score, axis=0))
+    safe_maximum = tl.where(next_maximum == float("-inf"), 0.0, next_maximum)
+    correction = tl.exp2(maximum - safe_maximum)
+    probability = tl.exp2(score - safe_maximum)
+    denominator = denominator * correction + tl.sum(probability, axis=0)
+    acc = acc * correction + tl.sum(probability[:, None] * latent, axis=0)
+    return next_maximum, denominator, acc
+
