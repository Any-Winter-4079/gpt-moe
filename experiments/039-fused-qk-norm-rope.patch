--- /dev/null
+++ b/experiments/check_qk_norm_rope.py
@@ -0,0 +1,101 @@
+from pathlib import Path
+import sys
+
+import torch
+from torch.nn import functional as F
+from torch.nn.attention.flex_attention import create_block_mask, flex_attention
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from model.attention.qk_norm_rope import qk_norm_rope
+from model.position.rotary import Rotary, apply_rotation
+
+
+def reference(q, k, q_scale, k_scale, cos, sin, eps, rms, scale_min, scale_max):
+    cos, sin = cos.to(q.dtype), sin.to(q.dtype)
+    q, k = apply_rotation(q, k, cos, sin)
+    q_statistic = q.pow(2).mean(-1, keepdim=True) if rms else q.pow(2).sum(-1, keepdim=True)
+    k_statistic = k.pow(2).mean(-1, keepdim=True) if rms else k.pow(2).sum(-1, keepdim=True)
+    q_gain = torch.rsqrt(q_statistic + eps).to(q.dtype)
+    k_gain = torch.rsqrt(k_statistic + eps).to(k.dtype)
+    q = q * q_gain * q_scale.clamp(scale_min, scale_max).to(q.dtype)
+    k = k * k_gain * k_scale.clamp(scale_min, scale_max).to(k.dtype)
+    return q, k
+
+
+def run(operation, inputs, cos, sin, rms, gradients, selected=(0, 1), core=None):
+    values = [value.detach().clone(memory_format=torch.preserve_format).requires_grad_(value.requires_grad) for value in inputs]
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        output = operation(*values, cos, sin, 1e-6, rms, -0.5, 1.5)
+        if core is not None:
+            output = (core(*output),)
+            selected = (0,)
+    needed = [value for value in values if value.requires_grad]
+    grads = torch.autograd.grad(tuple(output[index] for index in selected), needed, gradients, allow_unused=True)
+    grads = [torch.zeros_like(value) if grad is None else grad for value, grad in zip(needed, grads)]
+    return (*[value.detach() for value in output], *[grad.detach() for grad in grads])
+
+
+def check(actual, expected, label):
+    for index, (value, ref) in enumerate(zip(actual, expected)):
+        assert value.shape == ref.shape and torch.isfinite(value).all(), (label, index)
+        relative = (value.float() - ref.float()).norm() / ref.float().norm().clamp_min(1e-12)
+        print(f"{label} tensor {index}: relative L2={relative.item():.8f}")
+        assert relative < 0.03, (label, index, relative.item())
+
+
+torch.manual_seed(2026)
+assert torch.cuda.is_available(), "this correctness check requires CUDA"
+compiled = torch.compile(qk_norm_rope, fullgraph=True)
+compiled_reference = torch.compile(reference, fullgraph=True)
+
+for batch, heads, seq_len, head_size in ((2, 4, 33, 64), (1, 3, 17, 128), (1, 2, 9, 96), (1, 2, 3, 256), (2, 4, 513, 64)):
+    q = torch.randn(batch, seq_len, heads, head_size, device="cuda", dtype=torch.bfloat16).transpose(1, 2)
+    k = torch.randn_like(q)
+    q[:, :, 0] = 0
+    k[:, :, 0] *= 1e-4
+    q.requires_grad_()
+    k.requires_grad_()
+    q_scale = torch.tensor([-1.0, -0.5, 1.5, 2.0], device="cuda")[:heads].reshape(1, heads, 1, 1).requires_grad_()
+    k_scale = q_scale.detach().flip(1).clone().requires_grad_()
+    rotary = Rotary(head_size, 500_000, seq_len + 7).cuda()
+    cos = rotary.cos_cached[..., 7:seq_len + 7, :]
+    sin = rotary.sin_cached[..., 7:seq_len + 7, :]
+    gradients = [torch.randn(batch, seq_len, heads, head_size, device="cuda", dtype=torch.bfloat16).transpose(1, 2) for _ in range(2)]
+    inputs = (q, k, q_scale, k_scale)
+    for rms in (False, True):
+        label = f"shape={tuple(q.shape)} rms={rms}"
+        expected = run(reference, inputs, cos, sin, rms, gradients)
+        check(run(qk_norm_rope, inputs, cos, sin, rms, gradients), expected, label)
+        if seq_len == 33:
+            check(run(compiled, inputs, cos, sin, rms, gradients), run(compiled_reference, inputs, cos, sin, rms, gradients), label + " compiled")
+            for selected in ((0,), (1,)):
+                selected_grads = [gradients[index] for index in selected]
+                check(run(qk_norm_rope, inputs, cos, sin, rms, selected_grads, selected), run(reference, inputs, cos, sin, rms, selected_grads, selected), label + f" outputs={selected}")
+            for requires_qk in (False, True):
+                values = tuple(value.detach().requires_grad_(requires_qk if index < 2 else not requires_qk) for index, value in enumerate(inputs))
+                check(run(qk_norm_rope, values, cos, sin, rms, gradients), run(reference, values, cos, sin, rms, gradients), label + f" requires_qk={requires_qk}")
+
+batch, heads, seq_len, head_size = 2, 4, 33, 64
+q = torch.randn(batch, seq_len, heads, head_size, device="cuda", dtype=torch.bfloat16).transpose(1, 2).requires_grad_()
+k = torch.randn_like(q).requires_grad_()
+v = torch.randn_like(q)
+q_scale = torch.ones(1, heads, 1, 1, device="cuda", requires_grad=True)
+k_scale = torch.ones_like(q_scale, requires_grad=True)
+cos, sin = Rotary(head_size, 500_000, seq_len).cuda().get_cos_sin(seq_len, q.dtype, q.device)
+gradient = torch.randn_like(q)
+block_mask = create_block_mask(lambda b, h, q, k: q >= k, batch, heads, seq_len, seq_len, device="cuda")
+flex_core = torch.compile(lambda q, k: flex_attention(q, k, v, block_mask=block_mask), fullgraph=True)
+sdpa_core = lambda q, k: F.scaled_dot_product_attention(q, k, v, is_causal=True)
+for label, core in (("flex", flex_core), ("sdpa", sdpa_core)):
+    check(run(qk_norm_rope, (q, k, q_scale, k_scale), cos, sin, True, [gradient], core=core), run(reference, (q, k, q_scale, k_scale), cos, sin, True, [gradient], core=core), label)
+
+q_scale = torch.tensor([float("nan"), float("inf"), float("-inf"), 0.5], device="cuda").reshape(1, heads, 1, 1).requires_grad_()
+k_scale = q_scale.detach().flip(1).clone().requires_grad_()
+for rms in (False, True):
+    actual = run(qk_norm_rope, (q, k, q_scale, k_scale), cos, sin, rms, [gradient, gradient])
+    expected = run(reference, (q, k, q_scale, k_scale), cos, sin, rms, [gradient, gradient])
+    for value, ref in zip(actual, expected):
+        torch.testing.assert_close(value, ref, rtol=0.03, atol=0.03, equal_nan=True)
+    assert actual[-2][0, 0, 0, 0] == 0 and actual[-1][0, -1, 0, 0] == 0
+print("nonfinite learned-scale checks passed")
+print("fused QK normalization/RoPE checks passed")
