+from __future__ import annotations
+
+from typing import Any, Tuple
+
+import torch
+import triton
+from torch import Tensor
+from torch.library import custom_op, triton_op, wrap_triton
+
+from .deepgemm import grouped_fp8_wgrad
+from .grouped_fp8 import _quantize_activations, _quantize_weights_kernel
+
+
+@custom_op("gpt_moe::deepgemm_head_mm", mutates_args=())
+def _mm(a: Tensor, b: Tensor, a_scale: Tensor, b_scale: Tensor, dtype: torch.dtype) -> Tensor:
+    import deep_gemm
+
+    if torch.cuda.get_device_capability(a.device) != (12, 0):
+        raise ValueError("DeepGEMM FP8 language-model head requires SM120")
+    out = torch.empty((a.shape[0], b.shape[0]), device=a.device, dtype=dtype)
+    deep_gemm.fp8_gemm_nt((a, a_scale), (b, b_scale), out, recipe=(1, 128, 128))
+    return out
+
+
+@_mm.register_fake
+def _fake_mm(a: Tensor, b: Tensor, a_scale: Tensor, b_scale: Tensor, dtype: torch.dtype) -> Tensor:
+    return torch.empty((a.shape[0], b.shape[0]), device=a.device, dtype=dtype)
+
+
+@triton_op("gpt_moe::deepgemm_head_forward", mutates_args=())
+def _forward(x: Tensor, weight: Tensor, save_backward: bool, dtype: torch.dtype) -> Tuple[Tensor, Tensor, Tensor, Tensor, Tensor, Tensor]:
+    m, k = x.shape
+    n = weight.shape[0]
+    offsets = torch.full((1,), m, device=x.device, dtype=torch.int32)
+    row, row_scale, column, column_scale, _ = _quantize_activations(x, offsets, save_backward, True)
+    weight_fp8 = torch.empty(weight.shape, device=weight.device, dtype=torch.float8_e4m3fn)
+    weight_scale = torch.empty((triton.cdiv(n, 128), triton.cdiv(k, 128)), device=weight.device, dtype=torch.float32)
+    wrap_triton(_quantize_weights_kernel)[(1, triton.cdiv(n, 128), triton.cdiv(k, 128))](
+        weight, weight_fp8, weight_scale, n, k, 0, *weight.stride(), num_warps=8,
+    )
+    out = _mm(row, weight_fp8, row_scale, weight_scale, dtype)
+    return out, column, column_scale, weight_fp8, weight_scale, offsets
+
+
+@triton_op("gpt_moe::deepgemm_head_backward", mutates_args=())
+def _backward_gemms(
+    grad: Tensor, x_column: Tensor, x_scale: Tensor, weight: Tensor, weight_scale: Tensor,
+    offsets: Tensor, compute_dtype: torch.dtype, input_dtype: torch.dtype, weight_dtype: torch.dtype,
+) -> Tuple[Tensor, Tensor]:
+    row, row_scale, column, column_scale, padded_offsets = _quantize_activations(grad, offsets, True, True, True)
+    # a 128x128 weight block has the same scale after transposition
+    grad_x = _mm(row, weight.t().contiguous(), row_scale, weight_scale.t().contiguous(), compute_dtype)
+    grad_weight = grouped_fp8_wgrad(column, column_scale, x_column, x_scale, padded_offsets, compute_dtype)
+    return grad_x.to(input_dtype), grad_weight.squeeze(0).to(weight_dtype)
+
+
+def _setup_context(ctx: Any, inputs: Tuple, output: Tuple) -> None:
+    x, weight, _, ctx.compute_dtype = inputs
+    ctx.input_dtype = x.dtype
+    ctx.weight_dtype = weight.dtype
+    ctx.set_materialize_grads(False)
+    ctx.mark_non_differentiable(*output[1:])
+    ctx.save_for_backward(*output[1:])
+
+
+def _backward(ctx: Any, grad: Tensor, *unused: Tensor) -> Tuple:
+    x_column, x_scale, weight, weight_scale, offsets = ctx.saved_tensors
+    grad_x, grad_weight = _backward_gemms(
+        grad, x_column, x_scale, weight, weight_scale, offsets, ctx.compute_dtype, ctx.input_dtype, ctx.weight_dtype,
+    )
+    return grad_x, grad_weight, None, None
+
+
+_forward.register_autograd(_backward, setup_context=_setup_context)
+
+
+def linear_fp8(x: Tensor, weight: Tensor, bias: Tensor | None) -> Tensor:
+    dtype = torch.get_autocast_dtype("cuda") if torch.is_autocast_enabled("cuda") else x.dtype
+    save_backward = torch.is_grad_enabled() and (x.requires_grad or weight.requires_grad)
+    out = _forward(x.reshape(-1, x.shape[-1]), weight, save_backward, dtype)[0]
+    out = out.reshape(*x.shape[:-1], weight.shape[0])
+    return out if bias is None else out + bias.to(dtype)
