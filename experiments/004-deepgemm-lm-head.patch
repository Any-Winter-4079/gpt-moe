@@ -0,0 +1,62 @@
+from pathlib import Path
+import sys
+
+import torch
+from torch.nn import functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from model.linear.linear import Linear
+
+
+def quantized_reference(x, block_rows):
+    m, k = x.shape
+    padded = F.pad(x.detach().float(), (0, (-k) % 128, 0, (-m) % block_rows))
+    values = padded.reshape(-1, block_rows, padded.shape[1] // 128, 128)
+    amax = values.abs().amax((1, 3), keepdim=True)
+    scale = torch.where(amax == 0, 1.0, torch.exp2(torch.ceil(torch.log2(amax / 448.0))).clamp_min(2.0**-126))
+    return ((values / scale).to(torch.float8_e4m3fn).float() * scale).reshape(padded.shape)[:m, :k]
+
+
+def check(actual, expected, name, tolerance):
+    relative_error = (actual.float() - expected.float()).norm() / expected.float().norm().clamp_min(1e-12)
+    print(f"{name}: relative L2={relative_error.item():.8f}, dtype={actual.dtype}")
+    assert relative_error < tolerance, name
+
+
+torch.manual_seed(2026)
+torch.set_float32_matmul_precision("highest")
+head = Linear(256, 512, role="lm_head", bias=False).cuda()
+head.precision = "fp8"
+embedding = torch.nn.Embedding(512, 256, device="cuda")
+embedding.weight = head.weight
+weight = head.weight
+tokens = torch.tensor([1, 7, 7, 42], device="cuda")
+compiled = torch.compile(head, fullgraph=True)
+
+for label, layer in (("eager", head), ("compiled", compiled)):
+    head.zero_grad(set_to_none=True)
+    x = torch.randn(2, 129, 256, device="cuda", requires_grad=True)
+    with torch.autocast("cuda", dtype=torch.bfloat16):
+        out = layer(x)
+    assert out.shape == (2, 129, 512) and out.dtype == torch.bfloat16
+    grad = torch.randn_like(out) * .01
+    loss = (out.float() * grad.float()).sum() + embedding(tokens).sum()
+    loss.backward()
+
+    x_matrix = x.detach().reshape(-1, 256)
+    grad_matrix = grad.reshape(-1, 512)
+    quantized_weight = quantized_reference(weight, 128)
+    expected_out = (quantized_reference(x_matrix, 1) @ quantized_weight.t()).bfloat16()
+    expected_x_grad = (quantized_reference(grad_matrix, 1) @ quantized_weight).bfloat16().float()
+    expected_weight_grad = (quantized_reference(grad_matrix.t(), 1) @ quantized_reference(x_matrix.t(), 1).t()).bfloat16().float()
+    expected_weight_grad.index_add_(0, tokens, torch.ones(4, 256, device="cuda"))
+    check(out.reshape(-1, 512), expected_out, f"{label} output", .01)
+    check(x.grad.reshape(-1, 256), expected_x_grad, f"{label} input gradient", .001)
+    check(weight.grad, expected_weight_grad, f"{label} tied weight gradient", .001)
+    assert x.grad.dtype == weight.grad.dtype == torch.float32
+    assert head.weight is embedding.weight is weight
+
+head.precision = "default"
+with torch.autocast("cuda", dtype=torch.bfloat16):
+    torch.testing.assert_close(head(x), F.linear(x, weight), rtol=0, atol=0)
+print("PASS: eager/compiled head, BF16 output, FP32 gradients, tied embeddings and default precision")
