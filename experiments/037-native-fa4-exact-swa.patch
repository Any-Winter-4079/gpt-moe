diff --git a/experiments/check_flash_attention_4.py b/experiments/check_flash_attention_4.py
new file mode 100644
--- /dev/null
+++ b/experiments/check_flash_attention_4.py
@@ -0,0 +1,92 @@
+from pathlib import Path
+from types import SimpleNamespace
+import sys
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from model.attention.flash_attention_4 import flash_attention_4
+from model.attention.self_attention import SelfAttention
+from config.model import GPTConfig
+
+
+def reference(q, k, v, window, causal, local):
+    heads_per_kv = q.shape[2] // k.shape[2]
+    k = k.repeat_interleave(heads_per_kv, dim=2)
+    v = v.repeat_interleave(heads_per_kv, dim=2)
+    positions = torch.arange(q.shape[1], device=q.device)
+    distance = positions[:, None] - positions[None, :]
+    mask = torch.ones_like(distance, dtype=torch.bool)
+    if causal:
+        mask = mask & (distance >= 0)
+    if local:
+        # inclusive lookback W allows W+1 tokens counting the current token
+        mask = mask & ((distance <= window) if causal else (distance.abs() <= window))
+    scores = q.transpose(1, 2).float() @ k.transpose(1, 2).float().transpose(-1, -2)
+    scores = (scores / q.shape[-1]**.5).masked_fill(~mask, float("-inf"))
+    return (scores.softmax(-1) @ v.transpose(1, 2).float()).transpose(1, 2).bfloat16()
+
+
+def run(operation, values, grad, window, causal, local):
+    inputs = [value.detach().clone().requires_grad_() for value in values]
+    output = operation(*inputs, window, causal, local)
+    output.backward(grad)
+    return output.detach(), *(value.grad.detach() for value in inputs)
+
+
+def check(actual, expected, label):
+    for name, value, target in zip(("output", "dQ", "dK", "dV"), actual, expected):
+        assert value.shape == target.shape and value.dtype == torch.bfloat16, (label, name)
+        assert torch.isfinite(value).all(), (label, name)
+        difference = (value.float() - target.float()).norm()
+        relative_error = difference / target.float().norm().clamp_min(1e-6)
+        rms_error = difference / value.numel()**.5
+        print(f"{label} {name}: relative L2={relative_error.item():.8f}, absolute RMS={rms_error.item():.8f}")
+        tolerance = .006 if name == "output" else .03
+        assert relative_error < tolerance or rms_error < 1e-5, (label, name, relative_error.item(), rms_error.item())
+
+
+torch.manual_seed(2026)
+torch.set_float32_matmul_precision("highest")
+assert torch.cuda.is_available(), "this correctness check requires CUDA"
+assert torch.cuda.get_device_capability() == (12, 0), "this experiment requires SM120"
+for width, full_layer in ((7, False), (164, False), (168, False), (192, False), (192, True), (256, False)):
+    config = GPTConfig(
+        d_model=128, n_heads=4, n_kv_heads=4, attn_dim=4 * width,
+        full_attention_layers=[0] if full_layer else [], global_attn_dim=4 * width,
+        global_n_kv_heads=4, use_flash_attention_4=True,
+    )
+    try:
+        SelfAttention(config, SimpleNamespace())
+    except ValueError as error:
+        assert "head_size divisible by 8 and between 8 and 160" in str(error)
+    else:
+        raise AssertionError(f"unsupported native FA4 head width accepted: {width}")
+print("native FA4 numerical preflight; exact token SWA q-k <= W; no timing or model training")
+
+cases = 0
+for heads, kv_heads, head_size, seq_len in ((16, 16, 64, 127), (16, 4, 64, 257), (16, 1, 64, 513), (16, 4, 128, 129), (4, 2, 160, 65)):
+    torch.compiler.reset()
+    compiled = torch.compile(flash_attention_4, fullgraph=True, mode="max-autotune-no-cudagraphs", dynamic=False)
+    # q/k arrive from head-major RoPE/normalization; v retains the projection's token-major layout
+    values = [(torch.randn(2, count, seq_len, head_size, device="cuda", dtype=torch.bfloat16) * .2).transpose(1, 2) for count in (heads, kv_heads, kv_heads)]
+    values[2] = values[2].contiguous()
+    grad = torch.randn_like(values[0]) * .01
+    window = torch.tensor(0, dtype=torch.int32, device="cpu")
+    for causal in (True, False):
+        for local in (True, False):
+            graphs = None
+            for width in ((0, 1, 127, 128, 129) if local else (0,)):
+                window.fill_(width)
+                label = f"heads={heads}/{kv_heads} dim={head_size} tokens={seq_len} causal={causal} local={local} W={width}"
+                expected = run(reference, values, grad, width, causal, local)
+                check(run(flash_attention_4, values, grad, window, causal, local), expected, f"eager {label}")
+                check(run(compiled, values, grad, window, causal, local), expected, f"compiled {label}")
+                captured = torch._dynamo.utils.counters["stats"]["unique_graphs"]
+                if graphs is not None:
+                    assert captured == graphs, f"changing the host SWA window recompiled: {label}"
+                graphs = captured
+                cases += 1
+
+torch.cuda.synchronize()
+print(f"PASS: {cases} cases, eager/fullgraph forward and backward, changing host windows, causal/noncausal/full attention, ragged lengths, MHA/GQA/MQA")
