diff --git a/model/attention/flash_attention_4.py b/model/attention/flash_attention_4.py
new file mode 100644
--- /dev/null
+++ b/model/attention/flash_attention_4.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+from typing import Tuple
+
+import torch
+from torch import Tensor
+from torch.library import custom_op
+
+
+@custom_op("gpt_moe::flash_attention_4_forward", mutates_args=())
+def _forward(q: Tensor, k: Tensor, v: Tensor, window: Tensor, causal: bool, local: bool) -> Tuple[Tensor, Tensor]:
+    # flash-attn-4 4.0.0b36 / e7a6402a9ff099de5eb628ce207a88a3f0aa5378
+    from flash_attn.cute.interface import _flash_attn_fwd
+
+    if q.dtype not in (torch.bfloat16, torch.float16):
+        raise ValueError("FlashAttention 4 requires bfloat16 or float16 attention activations")
+    if torch.cuda.get_device_capability(q.device) != (12, 0):
+        raise ValueError("this FlashAttention 4 experiment requires SM120")
+    # the host scalar stays outside CUDA buffers and is read only inside this opaque operation
+    width = int(window.item()) if local else None
+    out, lse, _, _, _ = _flash_attn_fwd(
+        q, k, v, causal=causal, window_size_left=width,
+        window_size_right=0 if causal else width, return_lse=True,
+    )
+    return out, lse
+
+
+@_forward.register_fake
+def _fake_forward(q: Tensor, k: Tensor, v: Tensor, window: Tensor, causal: bool, local: bool) -> Tuple[Tensor, Tensor]:
+    out = torch.empty((*q.shape[:-1], v.shape[-1]), dtype=q.dtype, device=q.device)
+    lse = torch.empty((q.shape[0], q.shape[2], q.shape[1]), dtype=torch.float32, device=q.device)
+    return out, lse
+
+
+@custom_op("gpt_moe::flash_attention_4_backward", mutates_args=())
+def _backward(
+        q: Tensor, k: Tensor, v: Tensor, out: Tensor, grad: Tensor, lse: Tensor,
+        window: Tensor, causal: bool, local: bool,
+        ) -> Tuple[Tensor, Tensor, Tensor]:
+    from flash_attn.cute.interface import _flash_attn_bwd
+
+    width = int(window.item()) if local else None
+    return _flash_attn_bwd(
+        q, k, v, out, grad, lse, causal=causal,
+        window_size_left=width, window_size_right=0 if causal else width,
+    )
+
+
+@_backward.register_fake
+def _fake_backward(
+        q: Tensor, k: Tensor, v: Tensor, out: Tensor, grad: Tensor, lse: Tensor,
+        window: Tensor, causal: bool, local: bool,
+        ) -> Tuple[Tensor, Tensor, Tensor]:
+    return torch.empty_like(q), torch.empty_like(k), torch.empty_like(v)
+
+
+def _setup_context(ctx, inputs, output):
+    q, k, v, window, causal, local = inputs
+    out, lse = output
+    ctx.save_for_backward(q, k, v, out, lse, window)
+    ctx.causal = causal
+    ctx.local = local
+    ctx.mark_non_differentiable(lse)
+
+
+def _autograd_backward(ctx, grad, grad_lse):
+    q, k, v, out, lse, window = ctx.saved_tensors
+    dq, dk, dv = _backward(q, k, v, out, grad, lse, window, ctx.causal, ctx.local)
+    return dq, dk, dv, None, None, None
+
+
+_forward.register_autograd(_autograd_backward, setup_context=_setup_context)
+
+
+def flash_attention_4(q: Tensor, k: Tensor, v: Tensor, window: Tensor, causal: bool, local: bool) -> Tensor:
+    return _forward(q, k, v, window, causal, local)[0]
