+@torch.compile(dynamic=False, fullgraph=True)
+def row_energy_weighted_update(G: Tensor, update: Tensor) -> Tensor:
+    # restore bounded row activity and match the projected norm before output rounding
+    row_rms = G.float().square().mean(dim=-1, keepdim=True).sqrt()
+    gain = (row_rms / row_rms.mean(dim=-2, keepdim=True).clamp_min(1e-12)).sqrt().clamp(0.5, 2.0)
+    weighted = update * gain
+    original_norm = update.float().norm(dim=(-2, -1), keepdim=True)
+    weighted_norm = weighted.norm(dim=(-2, -1), keepdim=True).clamp_min(1e-12)
+    return (weighted * (original_norm / weighted_norm)).to(update.dtype)
+
