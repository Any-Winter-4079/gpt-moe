+def _head_backward(
+    X, Scale, Cos, Sin, Gain, DOut, batch, token, head, valid,
+    T: tl.constexpr, H: tl.constexpr,
+    xb: tl.constexpr, xh: tl.constexpr, xt: tl.constexpr, xd: tl.constexpr,
