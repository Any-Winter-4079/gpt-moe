+        apply_muon_updates_kernel[(len(weights), triton.cdiv(updates.size(-2) * updates.size(-1), 1024))](
+            tuple(weights), updates, updates.size(-2), updates.size(-1),
+            *updates.stride(), alpha, BLOCK=1024,
+        )
+    else:
+        for weight, update in zip(weights, updates):
+            weight.add_(update, alpha=alpha)
