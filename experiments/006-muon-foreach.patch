+def apply_muon_updates_kernel(
+    Weights, Updates,
+    M: tl.constexpr, N: tl.constexpr,
+    stride_b: tl.constexpr, stride_m: tl.constexpr, stride_n: tl.constexpr,
+    alpha,
+    BLOCK: tl.constexpr,
+):
+    matrix = tl.program_id(0)
+    offsets = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = offsets < M * N
+    update_offsets = matrix * stride_b + (offsets // N) * stride_m + (offsets % N) * stride_n
+    update = tl.load(Updates + update_offsets, mask=mask, other=0).to(tl.float32)
+    for index in tl.static_range(len(Weights)):
+        if matrix == index:
+            weight = tl.load(Weights[index] + offsets, mask=mask, other=0)
+            tl.store(Weights[index] + offsets, tl.fma(update, alpha, weight), mask=mask)
+
