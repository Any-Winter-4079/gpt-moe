+def capture_rng(generator):
+    return {
+        "python": random.getstate(), "numpy": np.random.get_state(), "torch": torch.get_rng_state(),
+        "cuda": torch.cuda.get_rng_state(), "loader": generator.get_state(),
+    }
+
+
+def restore_rng(state, generator):
+    random.setstate(state["python"])
+    np.random.set_state(state["numpy"])
+    torch.set_rng_state(state["torch"])
+    torch.cuda.set_rng_state(state["cuda"])
+    generator.set_state(state["loader"])
+
+
+def save_checkpoint(path, model, ema, optimizer, scheduler, scaler, epoch, best, model_config, training_config, rng, times):
+    temporary = path.with_suffix(".tmp")
+    torch.save({
+        "model": model.state_dict(), "model_ema": ema.module.state_dict(), "optimizer": optimizer.state_dict(),
+        "scheduler": scheduler.state_dict(), "scaler": scaler.state_dict(), "epoch": epoch, "best_top1": best,
+        "model_config": asdict(model_config), "training_config": asdict(training_config),
+        "rng": rng, "times": times,
+    }, temporary)
+    temporary.replace(path)
