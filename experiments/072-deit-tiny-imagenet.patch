+++ b/config/vision.py
@@ -0,0 +1,79 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass
+class VisionConfig:
+    image_size: int = 224
+    patch_size: int = 16
+    in_channels: int = 3
+    num_classes: int = 1000
+    hidden_size: int = 192
+    n_layers: int = 12
+    n_heads: int = 3
+    mlp_ratio: float = 4.0
+    qkv_bias: bool = True
+    norm_eps: float = 1e-6
+    dropout: float = 0.0
+    drop_path_rate: float = 0.1
+    attention_backend: str = "sdpa" # "sdpa" or "flex"; global, non-causal attention
+
+    def resolve(self) -> None:
+        if self.image_size <= 0 or self.patch_size <= 0 or self.image_size % self.patch_size:
+            raise ValueError("image_size must be positive and divisible by patch_size")
+        if self.hidden_size <= 0 or self.n_heads <= 0 or self.hidden_size % self.n_heads:
+            raise ValueError("hidden_size must be positive and divisible by n_heads")
+        if min(self.n_layers, self.num_classes, self.in_channels, int(self.hidden_size * self.mlp_ratio)) <= 0:
+            raise ValueError("vision layer, class, channel and MLP sizes must be positive")
+        if not 0 <= self.dropout < 1 or not 0 <= self.drop_path_rate < 1:
+            raise ValueError("dropout and drop_path_rate must be in [0, 1)")
+        if self.attention_backend not in ("sdpa", "flex"):
+            raise ValueError("attention_backend must be 'sdpa' or 'flex'")
+        if self.attention_backend == "flex" and self.dropout:
+            raise ValueError("FlexAttention does not support attention dropout; set dropout=0 or use SDPA")
+
+
+@dataclass
+class VisionTrainingConfig:
+    data_path: str = ""
+    output_dir: str = ""
+    epochs: int = 300
+    batch_size: int = 256
+    global_batch_size: int = 1024
+    workers: int = 8
+    precision: str = "fp16" # "fp32", "fp16" or "bf16"; parameters and AdamW moments stay FP32
+    base_lr: float = 5e-4
+    min_lr: float = 1e-5
+    warmup_lr: float = 1e-6
+    warmup_epochs: int = 5
+    weight_decay: float = 0.05
+    adamw_betas: tuple = (0.9, 0.999)
+    adamw_eps: float = 1e-8
+    ema_decay: float = 0.99996
+    mixup_alpha: float = 0.8
+    cutmix_alpha: float = 1.0
+    mixup_prob: float = 1.0
+    mixup_switch_prob: float = 0.5
+    label_smoothing: float = 0.1
+    auto_augment: str = "rand-m9-mstd0.5-inc1"
+    color_jitter: float = 0.4
+    random_erasing_prob: float = 0.25
+    repeated_augmentation: int = 3
+    seed: int = 0
+    log_interval: int = 50
+    compile_model: bool = False
+
+    def resolve(self, world_size: int) -> None:
+        if self.precision not in ("fp32", "fp16", "bf16"):
+            raise ValueError("precision must be 'fp32', 'fp16' or 'bf16'")
+        if self.batch_size < 2 or self.batch_size % 2:
+            raise ValueError("batch_size must be positive and even for batch Mixup/CutMix")
+        if self.global_batch_size <= 0 or self.global_batch_size % (self.batch_size * world_size):
+            raise ValueError("global_batch_size must be divisible by batch_size * world_size")
+        if self.epochs <= 0 or not 0 <= self.warmup_epochs <= self.epochs:
+            raise ValueError("epochs must be positive and warmup_epochs must be in [0, epochs]")
+        if self.workers < 0 or self.log_interval <= 0 or self.repeated_augmentation < 1:
+            raise ValueError("workers must be nonnegative; log_interval and repeated_augmentation must be positive")
+        self.grad_accum_steps = self.global_batch_size // (self.batch_size * world_size)
+        self.lr = self.base_lr * self.global_batch_size / 512
