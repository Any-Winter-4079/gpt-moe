@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+import contextlib
+import random
+import time
+from dataclasses import asdict
+
+import numpy as np
+import torch
+import torch.distributed as dist
+from torch.nn import functional as F
+
+
+def stop(signum, frame):
+    raise SystemExit(128 + signum)
+
+
+def precision_context(config):
+    if config.precision == "fp32":
+        return contextlib.nullcontext()
+    return torch.autocast("cuda", dtype=torch.float16 if config.precision == "fp16" else torch.bfloat16)
+
+
+def create_optimizer(model, config):
+    decay = []
+    no_decay = []
+    for name, parameter in model.named_parameters():
+        if parameter.ndim == 1 or name.endswith(".bias") or name in ("cls_token", "pos_embed"):
+            no_decay.append(parameter)
+        else:
+            decay.append(parameter)
+    return torch.optim.AdamW([
+        {"params": no_decay, "weight_decay": 0.0}, {"params": decay, "weight_decay": config.weight_decay},
+    ], lr=config.lr, betas=config.adamw_betas, eps=config.adamw_eps)
+
+
+def train_one_epoch(model, loader, optimizer, scaler, mixup, ema, device, config, epoch, rank, world_size, log):
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    totals = torch.zeros(2, dtype=torch.float64, device=device)
+    torch.cuda.synchronize(device)
+    start = time.perf_counter()
+    for index, (images, targets) in enumerate(loader):
+        images = images.to(device, non_blocking=True)
+        targets = targets.to(device, non_blocking=True)
+        images, targets = mixup(images, targets)
+        group_start = index // config.grad_accum_steps * config.grad_accum_steps
+        group_size = min(config.grad_accum_steps, len(loader) - group_start)
+        update = (index - group_start + 1) == group_size
+        sync = model.no_sync() if world_size > 1 and not update else contextlib.nullcontext()
+        with sync:
+            with precision_context(config):
+                logits = model(images)
+                loss = (-targets * F.log_softmax(logits.float(), dim=-1)).sum(dim=-1).mean()
+            if not torch.isfinite(loss):
+                raise FloatingPointError(f"non-finite vision training loss at epoch {epoch + 1}, batch {index + 1}")
+            scaler.scale(loss / group_size).backward()
+        if update:
+            scaler.step(optimizer)
+            scaler.update()
+            ema.update(model)
+            optimizer.zero_grad(set_to_none=True)
+        totals[0] += loss.detach() * images.shape[0]
+        totals[1] += images.shape[0]
+        if rank == 0 and ((index + 1) % config.log_interval == 0 or index + 1 == len(loader)):
+            log(f"epoch: {epoch + 1} | batch: {index + 1}/{len(loader)} | train loss: {loss.item():.6f} | lr: {optimizer.param_groups[0]['lr']:.8f}")
+    torch.cuda.synchronize(device)
+    elapsed = torch.tensor(time.perf_counter() - start, dtype=torch.float64, device=device)
+    if world_size > 1:
+        dist.all_reduce(totals)
+        dist.all_reduce(elapsed, op=dist.ReduceOp.MAX)
+    return {"loss": (totals[0] / totals[1]).item(), "images": int(totals[1].item()), "seconds": elapsed.item()}
+
+
+@torch.no_grad()
+def evaluate(model, loader, device, config, world_size):
+    model.eval()
+    totals = torch.zeros(4, dtype=torch.float64, device=device)
+    torch.cuda.synchronize(device)
+    start = time.perf_counter()
+    for images, targets in loader:
+        images = images.to(device, non_blocking=True)
+        targets = targets.to(device, non_blocking=True)
+        with precision_context(config):
+            logits = model(images)
+        totals[0] += F.cross_entropy(logits.float(), targets, reduction="sum")
+        predictions = logits.topk(min(5, logits.shape[-1]), dim=-1).indices
+        correct = predictions.eq(targets[:, None])
+        totals[1] += correct[:, :1].sum()
+        totals[2] += correct.any(dim=-1).sum()
+        totals[3] += images.shape[0]
+    torch.cuda.synchronize(device)
+    elapsed = torch.tensor(time.perf_counter() - start, dtype=torch.float64, device=device)
+    if world_size > 1:
+        dist.all_reduce(totals)
+        dist.all_reduce(elapsed, op=dist.ReduceOp.MAX)
+    return {
+        "loss": (totals[0] / totals[3]).item(), "top1": (100 * totals[1] / totals[3]).item(),
+        "top5": (100 * totals[2] / totals[3]).item(), "images": int(totals[3].item()), "seconds": elapsed.item(),
+    }
