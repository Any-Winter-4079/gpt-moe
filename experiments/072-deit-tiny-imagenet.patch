+++ b/data/vision.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import random
+from pathlib import Path
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader, Subset
+from torchvision import datasets, transforms
+from torchvision.transforms import InterpolationMode
+from timm.data import create_transform
+from timm.data.constants import IMAGENET_DEFAULT_MEAN, IMAGENET_DEFAULT_STD
+from timm.data.distributed_sampler import RepeatAugSampler
+
+
+def seed_worker(worker_id: int) -> None:
+    seed = torch.initial_seed() % (2 ** 32)
+    np.random.seed(seed)
+    random.seed(seed)
+
+
+def create_loaders(model_config, training_config, rank: int, world_size: int):
+    root = Path(training_config.data_path)
+    train_transform = create_transform(
+        input_size=model_config.image_size, is_training=True, color_jitter=training_config.color_jitter,
+        auto_augment=training_config.auto_augment, interpolation="bicubic",
+        mean=IMAGENET_DEFAULT_MEAN, std=IMAGENET_DEFAULT_STD,
+        re_prob=training_config.random_erasing_prob, re_mode="pixel", re_count=1,
+    )
+    val_transform = transforms.Compose([
+        transforms.Resize(int(model_config.image_size / (224 / 256)), interpolation=InterpolationMode.BICUBIC),
+        transforms.CenterCrop(model_config.image_size), transforms.ToTensor(),
+        transforms.Normalize(IMAGENET_DEFAULT_MEAN, IMAGENET_DEFAULT_STD),
+    ])
+    train_dataset = datasets.ImageFolder(root / "train", transform=train_transform)
+    val_dataset = datasets.ImageFolder(root / "val", transform=val_transform)
+    if train_dataset.class_to_idx != val_dataset.class_to_idx:
+        raise ValueError("train and val ImageFolder class names must match exactly")
+    if len(train_dataset.classes) != model_config.num_classes:
+        raise ValueError(f"expected {model_config.num_classes} ImageNet classes, found {len(train_dataset.classes)}")
+    sampler = RepeatAugSampler(
+        train_dataset, num_replicas=world_size, rank=rank,
+        num_repeats=training_config.repeated_augmentation, selected_round=256,
+    )
+    generator = torch.Generator().manual_seed(training_config.seed + rank)
+    train_loader = DataLoader(
+        train_dataset, sampler=sampler, batch_size=training_config.batch_size, drop_last=True,
+        num_workers=training_config.workers, pin_memory=True, worker_init_fn=seed_worker, generator=generator,
+    )
+    # disjoint validation shards count every image once, without distributed-sampler padding
+    val_loader = DataLoader(
+        Subset(val_dataset, range(rank, len(val_dataset), world_size)), batch_size=training_config.batch_size,
+        num_workers=training_config.workers, pin_memory=True, worker_init_fn=seed_worker,
+        generator=torch.Generator().manual_seed(training_config.seed + rank),
+    )
+    if not len(train_loader) or not len(val_dataset):
+        raise ValueError("ImageNet train and val folders must contain enough images for the configured batch_size")
+    return train_loader, val_loader, sampler, generator
