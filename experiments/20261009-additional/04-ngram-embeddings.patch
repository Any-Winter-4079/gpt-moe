diff --git a/model/ngram.py b/model/ngram.py
new file mode 100644
--- /dev/null
+++ b/model/ngram.py
@@ -0,0 +1,63 @@
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import torch.nn as nn
+from torch import Tensor
+from torch.nn import functional as F
+
+if TYPE_CHECKING:
+    from config.model import GPTConfig
+    from config.training import TrainingConfig
+
+
+class NgramEmbedding(nn.Module):
+    def __init__(self, gpt_config: GPTConfig, training_config: TrainingConfig) -> None:
+        super().__init__()
+        self.orders = tuple(gpt_config.ngram_orders)
+        dims = gpt_config.ngram_dims
+        sizes = gpt_config.ngram_table_sizes
+        assert len(self.orders) == len(dims) == len(sizes) > 0, "N-gram orders, dimensions and table sizes must have matching nonempty lengths"
+        assert all(order >= 2 for order in self.orders), "N-gram orders must be at least two"
+        assert all(dim > 0 for dim in dims), "N-gram dimensions must be positive"
+        assert all(0 < size < 2**31 for size in sizes), "N-gram table sizes must be positive and smaller than 2**31"
+        assert 0 < gpt_config.vocab_size < 2**31, "N-gram vocabulary size must be positive and smaller than 2**31"
+        self.pad_token_id = gpt_config.pad_token_id
+        self.eos_token_id = gpt_config.eos_token_id
+        self.use_bf16_autocast = training_config.use_bf16_autocast
+        self.cast_1d_weights_params_and_scales_to_weight_dtype_if_no_autocast = training_config.cast_1d_weights_params_and_scales_to_weight_dtype_if_no_autocast
+        self.tables = nn.ModuleList([nn.Embedding(size, dim) for size, dim in zip(sizes, dims)])
+        self.projections = nn.ModuleList([
+            nn.Linear(dim, gpt_config.d_model, bias=False) if dim != gpt_config.d_model else nn.Identity()
+            for dim in dims
+        ])
+        self.gates = nn.Parameter(torch.full((len(self.orders),), gpt_config.ngram_gate_init))
+
+    def forward(self, indices: Tensor, x: Tensor, document_ids: Optional[Tensor] = None) -> Tensor:
+        tokens = indices.to(dtype=torch.int64)
+        seq_len = tokens.size(1)
+        # EOS belongs to the ending document; history restarts on the following token
+        boundaries = torch.ones_like(tokens, dtype=torch.bool)
+        boundaries[:, 1:] = (tokens[:, :-1] == self.eos_token_id) | (tokens[:, :-1] == self.pad_token_id)
+        if document_ids is not None:
+            boundaries[:, 1:] |= document_ids[:, 1:] != document_ids[:, :-1]
+        segments = boundaries.to(dtype=torch.int64).cumsum(dim=1)
+        history_len = max(self.orders) - 1
+        token_history = F.pad(tokens, (history_len, 0))
+        segment_history = F.pad(segments, (history_len, 0), value=-1)
+
+        for i, (order, table, projection) in enumerate(zip(self.orders, self.tables, self.projections)):
+            hashes = torch.zeros_like(tokens)
+            # reduce each int64 step; products stay below 2**48 for the configured limits
+            for offset in range(order):
+                start = history_len - offset
+                hashes = (hashes * 65599 + token_history[:, start:start + seq_len] + 1) % table.num_embeddings
+            start = history_len - order + 1
+            valid = (tokens != self.pad_token_id) & (segments == segment_history[:, start:start + seq_len])
+            ngram = table(hashes)
+            if isinstance(projection, nn.Linear) and not self.use_bf16_autocast and self.cast_1d_weights_params_and_scales_to_weight_dtype_if_no_autocast and ngram.dtype != projection.weight.dtype:
+                ngram = ngram.to(dtype=projection.weight.dtype)
+            ngram = projection(ngram)
+            x = x + (self.gates[i].to(dtype=ngram.dtype) * ngram * valid.unsqueeze(-1)).to(dtype=x.dtype)
+        return x
