     return out
 
 
+@triton.autotune(
+    configs=[
+        triton.Config(
+            {"BLOCK_SIZE_M": bm, "BLOCK_SIZE_N": bn, "BLOCK_SIZE_K": 32},
+            num_stages=3, num_warps=4,
+        )
+        for bm, bn in [(32, 64), (64, 64), (64, 128)]
+    ],
+    key=["M", "N", "b_stride_r", "b_stride_c", "x_stride_r", "x_stride_c", "c_stride_r", "c_stride_c"],
+)
+@triton.jit
+def aX_plus_BX_kernel(
+    B_ptr, X_ptr, C_ptr,
+    M, N,
+    b_stride_b, b_stride_r, b_stride_c,
+    x_stride_b, x_stride_r, x_stride_c,
+    c_stride_b, c_stride_r, c_stride_c,
+    alpha,
+    BLOCK_SIZE_M: tl.constexpr,
+    BLOCK_SIZE_N: tl.constexpr,
+    BLOCK_SIZE_K: tl.constexpr,
+):
+    pid = tl.program_id(axis=0)
+    batch_idx = tl.program_id(axis=1)
+    num_pid_m = tl.cdiv(M, BLOCK_SIZE_M)
+    num_pid_n = tl.cdiv(N, BLOCK_SIZE_N)
+    pid_m, pid_n = tl.swizzle2d(pid // num_pid_n, pid % num_pid_n, num_pid_m, num_pid_n, 8)
+    m_idx = pid_m * BLOCK_SIZE_M
+    n_idx = pid_n * BLOCK_SIZE_N
+
+    B_ptr += batch_idx * b_stride_b
+    X_ptr += batch_idx * x_stride_b
+    C_ptr += batch_idx * c_stride_b
+
+    offs_m = (m_idx + tl.arange(0, BLOCK_SIZE_M)) % M
+    offs_n = (n_idx + tl.arange(0, BLOCK_SIZE_N)) % N
+    offs_k = tl.arange(0, BLOCK_SIZE_K)
+    b_ptrs = B_ptr + offs_m[:, None] * b_stride_r + offs_k[None, :] * b_stride_c
+    x_ptrs = X_ptr + offs_k[:, None] * x_stride_r + offs_n[None, :] * x_stride_c
+    accumulator = tl.zeros((BLOCK_SIZE_M, BLOCK_SIZE_N), dtype=tl.float32)
+    for k in tl.range(0, tl.cdiv(M, BLOCK_SIZE_K)):
+        b = tl.load(b_ptrs, mask=offs_k[None, :] < M - k * BLOCK_SIZE_K, other=0.0)
+        x = tl.load(x_ptrs, mask=offs_k[:, None] < M - k * BLOCK_SIZE_K, other=0.0)
+        accumulator = tl.dot(b, x, accumulator)
+        b_ptrs += BLOCK_SIZE_K * b_stride_c
+        x_ptrs += BLOCK_SIZE_K * x_stride_r
+
+    # add a * X before the only BF16 rounding and output store
+    offs_cm = m_idx + tl.arange(0, BLOCK_SIZE_M)
+    offs_cn = n_idx + tl.arange(0, BLOCK_SIZE_N)
+    mask = (offs_cm[:, None] < M) & (offs_cn[None, :] < N)
+    x_add_ptrs = X_ptr + offs_cm[:, None] * x_stride_r + offs_cn[None, :] * x_stride_c
+    x_add = tl.load(x_add_ptrs, mask=mask, other=0.0).to(tl.float32)
+    output = tl.fma(x_add, alpha, accumulator).to(tl.bfloat16)
+    c_ptrs = C_ptr + offs_cm[:, None] * c_stride_r + offs_cn[None, :] * c_stride_c
+    tl.store(c_ptrs, output, mask=mask)
+
+
+def fused_aX_plus_BX(B: Tensor, X: Tensor, alpha: float, out: Tensor):
+    """
+    Compute C = alpha * X + B @ X for strided BF16 matrices or batches.
+    out must have independent storage from B and X, with no overlapping elements.
+    """
+    assert X.ndim == 2 or X.ndim == 3
+    M, N = X.shape[-2:]
+    assert B.shape == (*X.shape[:-1], M), "Input matrices have incompatible shapes"
+    assert out.shape == X.shape, "Output matrix has incorrect shape"
+    assert B.dtype == X.dtype == out.dtype == torch.bfloat16
+    assert B.device == X.device == out.device and X.is_cuda
+
+    batch_size = X.size(0) if X.ndim == 3 else 1
+    grid = lambda meta: (
+        triton.cdiv(M, meta["BLOCK_SIZE_M"]) * triton.cdiv(N, meta["BLOCK_SIZE_N"]),
+        batch_size,
+    )
+    aX_plus_BX_kernel[grid](
+        B_ptr=B,
+        X_ptr=X,
+        C_ptr=out,
+        M=M,
+        N=N,
+        b_stride_b=B.stride(0) if B.ndim == 3 else 0,
+        b_stride_r=B.stride(-2),
+        b_stride_c=B.stride(-1),
+        x_stride_b=X.stride(0) if X.ndim == 3 else 0,
+        x_stride_r=X.stride(-2),
+        x_stride_c=X.stride(-1),
+        c_stride_b=out.stride(0) if out.ndim == 3 else 0,
+        c_stride_r=out.stride(-2),
+        c_stride_c=out.stride(-1),
+        alpha=alpha,
+    )
+    return out
+
