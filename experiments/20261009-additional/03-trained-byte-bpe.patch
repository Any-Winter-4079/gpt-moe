diff --git a/tokenizer/loader.py b/tokenizer/loader.py
new file mode 100644
index 0000000..a80ebb7
--- /dev/null
+++ b/tokenizer/loader.py
@@ -0,0 +1,80 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from importlib.metadata import version
+from pathlib import Path
+
+
+class ByteBPETokenizer:
+    def __init__(self, path: str) -> None:
+        from tokenizers import Tokenizer
+
+        artifact = Path(path).read_bytes()
+        self.artifact = artifact
+        self.tokenizer = Tokenizer.from_buffer(artifact)
+        self.n_vocab = self.tokenizer.get_vocab_size()
+        self.eot_token = self.tokenizer.token_to_id("<|endoftext|>")
+        if self.eot_token != 0 or not 257 <= self.n_vocab <= 65535:
+            raise ValueError("use a byte-BPE artifact produced by tokenizer.prepare with vocab_size <= 65535")
+        # encode literal special-token text as ordinary bytes; only the shard writer inserts EOS
+        self.tokenizer.encode_special_tokens = True
+        self.identity = {
+            "backend": "byte_bpe",
+            "sha256": hashlib.sha256(artifact).hexdigest(),
+            "library_version": version("tokenizers"),
+            "n_vocab": self.n_vocab,
+            "eos_token_id": self.eot_token,
+            "pad_token_id": self.n_vocab,
+        }
+
+    def save(self, path: str) -> None:
+        output = Path(path)
+        if output.exists() and output.read_bytes() != self.artifact:
+            raise ValueError("saved run tokenizer differs from the configured artifact")
+        output.write_bytes(self.artifact)
+
+    def encode(self, text: str) -> list[int]:
+        return self.tokenizer.encode(text, add_special_tokens=False).ids
+
+    def encode_ordinary(self, text: str) -> list[int]:
+        return self.encode(text)
+
+    def decode(self, tokens: list[int]) -> str:
+        return self.tokenizer.decode(tokens, skip_special_tokens=False)
+
+
+def load_tokenizer(backend: str, path: str):
+    if backend == "byte_bpe":
+        if not path:
+            raise ValueError("tokenizer_path is required for byte_bpe")
+        tokenizer = ByteBPETokenizer(path)
+        return tokenizer, tokenizer.identity
+    if backend != "gpt2":
+        raise ValueError("tokenizer_backend must be 'gpt2' or 'byte_bpe'")
+    if path:
+        raise ValueError("tokenizer_path must be empty for gpt2")
+    import tiktoken
+
+    tokenizer = tiktoken.get_encoding("gpt2")
+    return tokenizer, {
+        "backend": "gpt2",
+        "library_version": version("tiktoken"),
+        "n_vocab": tokenizer.n_vocab,
+        "eos_token_id": tokenizer.eot_token,
+        "pad_token_id": tokenizer.n_vocab,
+    }
+
+
+def validate_dataset_tokenizer(data_path: str, identity: dict) -> None:
+    folder = Path(data_path)
+    manifest_path = folder / "tokenizer_metadata.json"
+    if not manifest_path.is_file():
+        if identity["backend"] == "byte_bpe":
+            raise ValueError("custom tokenizers require new shards from tokenizer.prepare and tokenizer_metadata.json")
+        return
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    if manifest["tokenizer"] != identity:
+        raise ValueError("dataset tokenizer identity differs from the configured tokenizer; retokenize into a new directory")
+    if sorted(manifest["shards"]) != sorted(path.name for path in folder.glob("*.npy")):
+        raise ValueError("dataset shard files differ from tokenizer_metadata.json")
diff --git a/tokenizer/prepare.py b/tokenizer/prepare.py
new file mode 100644
index 0000000..a0e921f
--- /dev/null
+++ b/tokenizer/prepare.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+import argparse
+import json
+from itertools import islice
+from pathlib import Path
+
+from tokenizer.loader import load_tokenizer
+
+
+def read_documents(paths: list[str]):
+    for path in paths:
+        with open(path, encoding="utf-8") as file:
+            for line in file:
+                yield json.loads(line)["text"]
+
+
+def train_tokenizer(args) -> None:
+    from tokenizers import Tokenizer, decoders, models, pre_tokenizers, trainers
+
+    if not 257 <= args.vocab_size <= 65535:
+        raise ValueError("vocab_size must be between 257 and 65535, including EOS")
+    if args.min_frequency < 1 or args.max_documents < 1:
+        raise ValueError("min_frequency and max_documents must be positive")
+    output = Path(args.output)
+    if output.exists():
+        raise ValueError("output tokenizer already exists; use a new artifact path")
+    tokenizer = Tokenizer(models.BPE())
+    tokenizer.pre_tokenizer = pre_tokenizers.ByteLevel(add_prefix_space=False, use_regex=True)
+    tokenizer.decoder = decoders.ByteLevel()
+    trainer = trainers.BpeTrainer(
+        vocab_size=args.vocab_size,
+        min_frequency=args.min_frequency,
+        initial_alphabet=pre_tokenizers.ByteLevel.alphabet(),
+        special_tokens=["<|endoftext|>"],
+        show_progress=True,
+    )
+    # only training documents may fit the vocabulary; validation/test text is supplied later for encoding
+    documents = islice(read_documents(args.train_jsonl), args.max_documents)
+    tokenizer.train_from_iterator(documents, trainer=trainer)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    tokenizer.save(str(output))
+    _, identity = load_tokenizer("byte_bpe", str(output))
+    print(json.dumps(identity, indent=2))
+
+
+def write_shards(paths: list[str], split: str, output: Path, tokenizer, shard_size: int) -> list[str]:
+    import numpy as np
+
+    buffer = np.empty(shard_size, dtype=np.uint16)
+    token_count = 0
+    shard_names = []
+    for text in read_documents(paths):
+        ids = [tokenizer.eot_token] + tokenizer.encode_ordinary(text)
+        if min(ids) < 0 or max(ids) >= 2**16:
+            raise ValueError("token dictionary too large for uint16")
+        tokens = np.asarray(ids, dtype=np.uint16)
+        offset = 0
+        # a document can span any number of shards
+        while offset < len(tokens):
+            count = min(shard_size - token_count, len(tokens) - offset)
+            buffer[token_count:token_count + count] = tokens[offset:offset + count]
+            offset += count
+            token_count += count
+            if token_count == shard_size:
+                name = f"corpus_{split}_{len(shard_names):06d}.npy"
+                np.save(output / name, buffer)
+                shard_names.append(name)
+                token_count = 0
+    if token_count:
+        name = f"corpus_{split}_{len(shard_names):06d}.npy"
+        np.save(output / name, buffer[:token_count])
+        shard_names.append(name)
+    if not shard_names:
+        raise ValueError(f"no documents supplied for {split}")
+    return shard_names
+
+
+def tokenize_corpus(args) -> None:
+    if args.shard_size < 1:
+        raise ValueError("shard_size must be positive")
+    train_paths = {Path(path).resolve() for path in args.train_jsonl}
+    val_paths = {Path(path).resolve() for path in args.val_jsonl}
+    if train_paths & val_paths:
+        raise ValueError("training and validation must use separate source files")
+    tokenizer, identity = load_tokenizer(args.backend, args.tokenizer)
+    output = Path(args.output_dir)
+    # refusing existing directories prevents mixing these IDs with old GPT-2 shards
+    output.mkdir(parents=True, exist_ok=False)
+    shard_names = write_shards(args.train_jsonl, "train", output, tokenizer, args.shard_size)
+    shard_names.extend(write_shards(args.val_jsonl, "val", output, tokenizer, args.shard_size))
+    # publish the manifest only when both splits have completed
+    (output / "tokenizer_metadata.json").write_text(
+        json.dumps({"tokenizer": identity, "shards": shard_names}, indent=2) + "\n", encoding="utf-8",
+    )
+    print(f"saved {len(shard_names)} shards to {output}")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Train a byte-BPE tokenizer or tokenize local JSONL documents")
+    commands = parser.add_subparsers(dest="command", required=True)
+    train = commands.add_parser("train", help="fit BPE on training-only JSONL text")
+    train.add_argument("--train-jsonl", nargs="+", required=True)
+    train.add_argument("--output", required=True)
+    train.add_argument("--vocab-size", type=int, default=32768)
+    train.add_argument("--min-frequency", type=int, default=2)
+    train.add_argument("--max-documents", type=int, default=100000)
+    train.set_defaults(fn=train_tokenizer)
+    shards = commands.add_parser("shards", help="encode disjoint local train/val JSONL into uint16 npy shards")
+    shards.add_argument("--backend", choices=("gpt2", "byte_bpe"), default="byte_bpe")
+    shards.add_argument("--tokenizer", default="")
+    shards.add_argument("--train-jsonl", nargs="+", required=True)
+    shards.add_argument("--val-jsonl", nargs="+", required=True)
+    shards.add_argument("--output-dir", required=True)
+    shards.add_argument("--shard-size", type=int, default=100000000)
+    shards.set_defaults(fn=tokenize_corpus)
+    args = parser.parse_args()
+    args.fn(args)
