diff --git a/optimizers/lion.py b/optimizers/lion.py
new file mode 100644
--- /dev/null
+++ b/optimizers/lion.py
@@ -0,0 +1,70 @@
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _lion_step_kernel(P, G, M, N: tl.constexpr, lr, beta1, beta2, one_minus_beta1, one_minus_beta2, decay, BLOCK: tl.constexpr):
+    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offsets < N
+    p = tl.load(P + offsets, mask=mask, other=0.0).to(tl.float32)
+    g = tl.load(G + offsets, mask=mask, other=0.0).to(tl.float32)
+    m = tl.load(M + offsets, mask=mask, other=0.0)
+    update = beta1 * m + one_minus_beta1 * g
+    direction = tl.where(update > 0.0, 1.0, tl.where(update < 0.0, -1.0, 0.0))
+    p = p * decay - lr * direction
+    m = beta2 * m + one_minus_beta2 * g
+    tl.store(P + offsets, p, mask=mask)
+    tl.store(M + offsets, m, mask=mask)
+
+
+class FusedLion(torch.optim.Optimizer):
+    """Google Lion equations, fused per tensor with FP32 arithmetic and momentum."""
+
+    def __init__(self, params, lr=1e-4, betas=(0.9, 0.99), weight_decay=0.0):
+        super().__init__(params, dict(lr=lr, betas=betas, weight_decay=weight_decay))
+        for group in self.param_groups:
+            if not group['lr'] >= 0 or not group['weight_decay'] >= 0:
+                raise ValueError("Lion requires nonnegative learning rate and weight decay")
+            if len(group['betas']) != 2 or any(not 0 <= beta < 1 for beta in group['betas']):
+                raise ValueError("Lion requires two betas in [0, 1)")
+            for p in group['params']:
+                if not p.is_cuda or not p.is_contiguous():
+                    raise ValueError("fused Lion requires contiguous CUDA parameters")
+                if p.dtype not in (torch.float32, torch.bfloat16, torch.float16):
+                    raise ValueError("fused Lion requires float32, bfloat16 or float16 parameters")
+
+    def load_state_dict(self, state_dict):
+        super().load_state_dict(state_dict)
+        # restore saved FP32 values before parameter-dtype casting loses momentum precision
+        for group, saved_group in zip(self.param_groups, state_dict['param_groups']):
+            for p, index in zip(group['params'], saved_group['params']):
+                saved = state_dict['state'].get(index)
+                if saved is not None:
+                    self.state[p]['exp_avg'] = saved['exp_avg'].to(device=p.device, dtype=torch.float32).clone()
+
+    @torch.no_grad()
+    def step(self, closure=None):
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        for group in self.param_groups:
+            beta1, beta2 = group['betas']
+            for p in group['params']:
+                if p.grad is None or p.numel() == 0:
+                    continue
+                if p.grad.is_sparse:
+                    raise ValueError("fused Lion does not support sparse gradients")
+                state = self.state[p]
+                if 'exp_avg' not in state:
+                    state['exp_avg'] = torch.zeros_like(p, dtype=torch.float32)
+                grad = p.grad.contiguous()
+                _lion_step_kernel[(triton.cdiv(p.numel(), 1024),)](
+                    p, grad, state['exp_avg'], p.numel(), group['lr'], beta1, beta2,
+                    1.0 - beta1, 1.0 - beta2, 1.0 - group['lr'] * group['weight_decay'],
+                    BLOCK=1024, enable_fp_fusion=False,
+                )
+        return loss
