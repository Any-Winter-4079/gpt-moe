+    def _build_mla_cached_mask(self, attn_mask: Optional[Tensor], document_ids: Optional[Tensor], batch_size: int, seq_len: int, start_pos: int, device: Union[str, torch.device], apply_swa: bool) -> Optional[Union[Tensor, BlockMask]]:
