+    tl.store(Out + (row * SPLITS + split) * R + r, acc / normalizer, mask=r < R)
+    if SPLITS > 1:
+        tl.store(
+            Lse + row * SPLITS + split,
+            tl.where(denominator > 0.0, maximum + tl.log2(normalizer), float("-inf")),
+        )
+    else:
+        tl.store(Mass + row, (denominator > 0.0).to(tl.float32))
+
+
+@triton.jit
+def _mla_decode_merge_kernel(
+    Partial, Lse, Out, Mass,
+    R: tl.constexpr, SPLITS: tl.constexpr,
+    BLOCK_R: tl.constexpr, BLOCK_S: tl.constexpr,
+):
+    row = tl.program_id(0)
+    split = tl.arange(0, BLOCK_S)
+    r = tl.arange(0, BLOCK_R)
+    lse = tl.load(Lse + row * SPLITS + split, mask=split < SPLITS, other=float("-inf"))
+    maximum = tl.max(lse, axis=0)
+    safe_maximum = tl.where(maximum == float("-inf"), 0.0, maximum)
+    weights = tl.exp2(lse - safe_maximum)
+    denominator = tl.sum(weights, axis=0)
+    partial = tl.load(
+        Partial + (row * SPLITS + split[:, None]) * R + r[None, :],
+        mask=(split[:, None] < SPLITS) & (r[None, :] < R), other=0.0,
+    )
+    acc = tl.sum(weights[:, None] * partial, axis=0)
+    tl.store(Out + row * R + r, acc / tl.where(denominator > 0.0, denominator, 1.0), mask=r < R)
+    tl.store(Mass + row, (denominator > 0.0).to(tl.float32))
+
+
+@triton_op("gpt_moe::mla_decode", mutates_args=())
+def mla_decode(
+    q_latent: Tensor, q_rope: Tensor, query_bias: Tensor,
+    latent: Tensor, rope: Tensor, key_gain: Tensor, mask: Tensor,
+    scale: float, softcap: float, backend: str, window_size: Optional[Tensor] = None,
+) -> Tuple[Tensor, Tensor]:
+    if q_latent.ndim != 4 or latent.ndim != 3 or key_gain.ndim != 3 or q_rope.ndim != 4:
+        raise ValueError("MLA decode expects [batch, heads, queries, rank] queries and [batch, keys, rank] cache")
+    batch, heads, queries, rank = q_latent.shape
+    keys = latent.shape[1]
+    positional = q_rope.shape[-1]
+    kv_heads = key_gain.shape[-1]
+    if batch < 1 or heads < 1 or queries < 1 or keys < 1 or rank < 1 or rank > 1024:
+        raise ValueError("MLA decode requires nonempty inputs and a latent rank in [1, 1024]")
+    if positional > 1024 or kv_heads < 1 or heads % kv_heads:
+        raise ValueError("MLA decode requires a positional width at most 1024 and query heads divisible by KV heads")
+    if (
+        latent.shape != (batch, keys, rank)
+        or q_rope.shape != (batch, heads, queries, positional)
+        or rope.shape != (batch, keys, positional)
+        or key_gain.shape != (batch, keys, kv_heads)
+        or query_bias.shape != (batch, heads, queries)
+        or mask.shape != (batch, 1, queries, keys)
+    ):
+        raise ValueError("MLA decode input shapes do not match")
+    if not q_latent.is_cuda or any(
+        tensor.device != q_latent.device
+        for tensor in (q_rope, query_bias, latent, rope, key_gain, mask)
+    ):
+        raise ValueError("MLA decode inputs must be on the same CUDA device")
+    if any(
+        tensor.dtype not in (torch.float32, torch.bfloat16)
+        for tensor in (q_latent, q_rope, query_bias, latent, rope, key_gain)
+    ) or mask.dtype != torch.bool:
+        raise ValueError("MLA decode requires float32 or bfloat16 inputs and a boolean mask")
+    if (
+        q_latent.stride(-1) != 1
+        or latent.stride(-1) != 1 or latent.stride(-2) != rank
+        or (positional > 0 and (q_rope.stride(-1) != 1 or rope.stride(-1) != 1 or rope.stride(-2) != positional))
+        or key_gain.stride(-1) != 1 or key_gain.stride(-2) != kv_heads
+        or not mask.is_contiguous()
+    ):
+        raise ValueError("MLA decode requires contiguous feature rows and a contiguous attention mask")
+    if softcap < 0.0 or backend not in ("clamp", "rational", "ptx", "exact"):
+        raise ValueError("MLA decode requires a nonnegative softcap and a supported tanh backend")
+    if window_size is not None and (window_size.ndim != 0 or window_size.dtype != torch.int32 or window_size.device != q_latent.device):
+        raise ValueError("MLA decode window_size must be a scalar int32 tensor on the query device")
+
+    # parallelize the cache scan when a small decode batch cannot fill the GPU
+    rows = batch * heads * queries
+    sm_count = torch.cuda.get_device_properties(q_latent.device).multi_processor_count
+    splits = min(16, triton.cdiv(sm_count * 2, rows), triton.cdiv(keys, 256))
+    context = torch.empty(q_latent.shape, device=q_latent.device, dtype=torch.float32)
+    mass = torch.empty((batch, heads, queries), device=q_latent.device, dtype=torch.float32)
+    partial = torch.empty((rows, splits, rank), device=q_latent.device, dtype=torch.float32) if splits > 1 else context
+    lse = torch.empty((rows, splits), device=q_latent.device, dtype=torch.float32) if splits > 1 else mass
+    block_r = triton.next_power_of_2(rank)
+    block_p = triton.next_power_of_2(positional) if positional else 1
+    block_k = 16 if block_r + block_p > 512 else 32
+    warps = 8 if block_r + block_p > 256 else 4
+    wrap_triton(_mla_decode_kernel)[(rows, splits)](
+        q_latent, q_rope, query_bias, latent, rope, key_gain, mask, mask if window_size is None else window_size, partial, lse, mass,
+        keys, latent.stride(0), rope.stride(0), key_gain.stride(0),
+        heads, queries, rank, positional, kv_heads, splits, window_size is not None,
+        *q_latent.stride()[:3], *q_rope.stride()[:3], *query_bias.stride(),
+        scale, softcap, backend, block_k, block_r, block_p,
+        num_warps=warps,
+    )
+    if splits > 1:
+        wrap_triton(_mla_decode_merge_kernel)[(rows,)](
+            partial, lse, context, mass, rank, splits, block_r, triton.next_power_of_2(splits),
+            num_warps=4,
+        )
+    return context, mass
