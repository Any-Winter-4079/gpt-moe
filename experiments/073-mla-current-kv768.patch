+from __future__ import annotations
+
+from typing import Optional, Tuple
+
+import torch
+import triton
+import triton.language as tl
+from torch import Tensor
+from torch.library import triton_op, wrap_triton
+from triton.language.extra.cuda import libdevice
+
+
+@triton.jit
+def _mla_decode_kernel(
+    QLatent, QRope, QueryBias, Latent, Rope, KeyGain, Mask, Window, Out, Lse, Mass,
+    K, latent_stride_b, rope_stride_b, gain_stride_b,
+    H: tl.constexpr, Q: tl.constexpr, R: tl.constexpr, P: tl.constexpr,
+    KV_HEADS: tl.constexpr, SPLITS: tl.constexpr, HAS_WINDOW: tl.constexpr,
+    ql_stride_b: tl.constexpr, ql_stride_h: tl.constexpr, ql_stride_q: tl.constexpr,
+    qr_stride_b: tl.constexpr, qr_stride_h: tl.constexpr, qr_stride_q: tl.constexpr,
+    bias_stride_b: tl.constexpr, bias_stride_h: tl.constexpr, bias_stride_q: tl.constexpr,
+    SCALE: tl.constexpr, SOFTCAP: tl.constexpr, BACKEND: tl.constexpr,
+    BLOCK_K: tl.constexpr, BLOCK_R: tl.constexpr, BLOCK_P: tl.constexpr,
+):
+    row = tl.program_id(0)
+    split = tl.program_id(1)
+    query = row % Q
+    head = (row // Q) % H
+    batch = row // (H * Q)
+    kv_head = head // (H // KV_HEADS)
+    r = tl.arange(0, BLOCK_R)
+    q_latent = tl.load(
+        QLatent + batch * ql_stride_b + head * ql_stride_h + query * ql_stride_q + r,
+        mask=r < R, other=0.0,
+    ).to(tl.float32)
+    query_bias = tl.load(
+        QueryBias + batch * bias_stride_b + head * bias_stride_h + query * bias_stride_q,
+    ).to(tl.float32)
+    if P:
+        p = tl.arange(0, BLOCK_P)
+        q_rope = tl.load(
+            QRope + batch * qr_stride_b + head * qr_stride_h + query * qr_stride_q + p,
+            mask=p < P, other=0.0,
+        ).to(tl.float32)
+
+    maximum = tl.full((), float("-inf"), tl.float32)
+    denominator = tl.full((), 0.0, tl.float32)
+    acc = tl.zeros((BLOCK_R,), tl.float32)
+    first_key = 0
+    if HAS_WINDOW:
+        # the earliest query bounds the union; the exact mask still filters each row
+        window = tl.maximum(tl.load(Window), 0)
+        first_key = tl.maximum(0, K - Q - window)
+    keys_in_range = K - first_key
+    start = first_key + keys_in_range * split // SPLITS
+    end = first_key + keys_in_range * (split + 1) // SPLITS
+    for tile in range(tl.cdiv(end - start, BLOCK_K)):
+        key = start + tile * BLOCK_K + tl.arange(0, BLOCK_K)
+        valid = tl.load(
+            Mask + (batch * Q + query) * K + key,
+            mask=key < end, other=False,
+        )
+        # skip masked cache rows before loading the latent and positional operands
+        if tl.sum(valid.to(tl.int32), axis=0) > 0:
+            latent = tl.load(
+                Latent + batch * latent_stride_b + key[:, None] * R + r[None, :],
+                mask=valid[:, None] & (r[None, :] < R), other=0.0,
+            ).to(tl.float32)
+            score = tl.sum(latent * q_latent[None, :], axis=1) + query_bias
+            if P:
+                rope = tl.load(
+                    Rope + batch * rope_stride_b + key[:, None] * P + p[None, :],
+                    mask=valid[:, None] & (p[None, :] < P), other=0.0,
+                ).to(tl.float32)
+                score += tl.sum(rope * q_rope[None, :], axis=1)
+            gain = tl.load(
+                KeyGain + batch * gain_stride_b + key * KV_HEADS + kv_head,
+                mask=valid, other=0.0,
+            ).to(tl.float32)
+            score = score * gain * SCALE
+            if SOFTCAP > 0.0:
+                if BACKEND == "clamp":
+                    score = tl.where(score != score, score, tl.minimum(tl.maximum(score, -SOFTCAP), SOFTCAP))
+                elif BACKEND == "rational":
+                    z = score / SOFTCAP
+                    z = tl.where(z != z, z, tl.minimum(tl.maximum(z, -3.0), 3.0))
+                    square = z * z
+                    score = SOFTCAP * z * (27.0 + square) / (27.0 + 9.0 * square)
+                elif BACKEND == "ptx":
+                    score = SOFTCAP * tl.inline_asm_elementwise(
+                        "tanh.approx.f32 $0, $1;", constraints="=f,f",
+                        args=[score / SOFTCAP], dtype=tl.float32, is_pure=True, pack=1,
+                    )
+                else:
