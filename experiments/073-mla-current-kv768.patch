--- /dev/null
+++ b/model/attention/mla.py
@@ -0,0 +1,254 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Optional, Tuple, Union
+
+import torch
+import torch.nn as nn
+from torch import Tensor
+from torch.nn import functional as F
+from torch.nn.attention.flex_attention import BlockMask, flex_attention
+from torch.utils.checkpoint import checkpoint
+
+from ..linear.linear import Linear
+from ..linear.fp8.custom.dense import project, quantize_weights
+from ..linear.fp8.custom.output_projection import project_output
+from ..position.rotary import Rotary, apply_rotation
+from .logit_softcapping import generate_tanh_softcap
+
+if TYPE_CHECKING:
+    from config.model import GPTConfig
+    from config.training import TrainingConfig
+
+
+@dataclass
+class MLACache:
+    latent: Tensor
+    rope: Tensor
+    key_gain: Tensor
+    length: int = 0
+    factors: Optional[Tuple[Tensor, Tensor, Tensor]] = None
+
+
+# joint KV compression and decoupled RoPE follow DeepSeek-V2/V3
+# https://github.com/deepseek-ai/DeepSeek-V3/blob/main/inference/model.py
+class MultiHeadLatentAttention(nn.Module):
+    def __init__(self, gpt_config: GPTConfig, training_config: TrainingConfig, layer_idx: int = 0) -> None:
+        super().__init__()
+        self.n_heads = gpt_config.n_heads
+        is_full_attention = layer_idx in gpt_config.full_attention_layers
+        self.n_kv_heads = gpt_config.global_n_kv_heads if is_full_attention else gpt_config.n_kv_heads
+        assert 1 <= self.n_kv_heads <= self.n_heads, "n_kv_heads must be in [1, n_heads]"
+        assert self.n_heads % self.n_kv_heads == 0, "n_heads must be divisible by n_kv_heads for GQA/MQA"
+        self.q_heads_per_kv_head = self.n_heads // self.n_kv_heads
+        self.q_rank = gpt_config.mla_q_rank
+        self.kv_rank = gpt_config.mla_kv_rank
+        self.content_dim = gpt_config.mla_qk_content_dim
+        self.rope_dim = gpt_config.mla_qk_rope_dim
+        self.value_dim = gpt_config.mla_value_dim
+        self.head_size = self.content_dim + self.rope_dim
+        self.attn_dim = self.n_heads * self.value_dim
+        if self.q_rank < 0 or min(self.kv_rank, self.content_dim, self.value_dim) <= 0 or self.rope_dim < 0 or self.rope_dim % 2:
+            raise ValueError("MLA requires non-negative query rank, positive KV/content/value dimensions and even non-negative RoPE dimension")
+        if gpt_config.pos_encoding_type.lower() == "rope" and self.rope_dim == 0:
+            raise ValueError("MLA with RoPE requires mla_qk_rope_dim > 0")
+        if gpt_config.pos_encoding_type.lower() != "rope" and self.rope_dim:
+            raise ValueError("MLA without RoPE requires mla_qk_rope_dim=0")
+        for phase, policy in training_config.linear_config.items():
+            if policy["k_proj"] != policy["v_proj"]:
+                raise ValueError(f"MLA joint KV projections require matching k_proj and v_proj precision/backend for {phase}")
+
+        if self.q_rank:
+            self.q_down_proj = Linear(gpt_config.hidden_size, self.q_rank, role="q_proj", bias=gpt_config.use_bias)
+            self.q_norm = nn.RMSNorm(self.q_rank, eps=gpt_config.mla_norm_eps)
+        self.q_proj = Linear(self.q_rank or gpt_config.hidden_size, self.n_heads * self.head_size, role="q_proj", bias=gpt_config.use_bias)
+        self.kv_down_proj = Linear(gpt_config.hidden_size, self.kv_rank + self.rope_dim, role="k_proj", bias=gpt_config.use_bias)
+        self.kv_norm = nn.RMSNorm(self.kv_rank, eps=gpt_config.mla_norm_eps)
+        self.kv_up_proj = Linear(self.kv_rank, self.n_kv_heads * (self.content_dim + self.value_dim), role="k_proj", bias=gpt_config.use_bias)
+        self.out_proj = Linear(self.attn_dim, gpt_config.hidden_size, role="out_proj", bias=gpt_config.use_bias)
+        self.prepared_weights = {}
+        rope_theta = gpt_config.global_rope_theta if is_full_attention else gpt_config.rope_base_theta
+        self.rotary = Rotary(self.rope_dim, rope_theta, training_config.max_seq_len) if self.rope_dim else None
+
+        self.use_qk_norm = gpt_config.use_qk_norm
+        self.qk_norm_type = gpt_config.qk_norm_type
+        self.qk_scale_min = gpt_config.qk_scale_min
+        self.qk_scale_max = gpt_config.qk_scale_max
+        self.qk_eps = gpt_config.qk_eps
+        if self.use_qk_norm:
+            self.q_scale = nn.Parameter(torch.full((1, self.n_heads, 1, 1), gpt_config.qk_scale_init))
+            self.k_scale = nn.Parameter(torch.full((1, self.n_kv_heads, 1, 1), gpt_config.qk_scale_init))
+        self.use_bf16_autocast = training_config.use_bf16_autocast
+        self.cast_activations_to_weight_dtype_if_no_autocast = training_config.cast_activations_to_weight_dtype_if_no_autocast
+        self.use_flex_attention = gpt_config.use_flex_attention
+        self.is_causal = gpt_config.is_causal
+        self.recompute_attention = gpt_config.mla_recompute_attention
+        self.softmax_scale = self.head_size ** -0.5
+        self.attn_logit_softcap = gpt_config.attn_logit_softcap if gpt_config.use_attn_logit_softcapping else 0.0
+        self.tanh_backend = gpt_config.tanh_backend
+        self._score_mod = generate_tanh_softcap(self.attn_logit_softcap, backend=self.tanh_backend) if self.attn_logit_softcap else None
+
+    @torch.no_grad()
+    def prepare_fp8_weights(self) -> None:
+        self.clear_fp8_weights()
+        names = ("q_proj", "kv_down_proj", "kv_up_proj", "out_proj")
+        if self.q_rank:
+            names = ("q_down_proj",) + names
+        for name in names:
+            projection = getattr(self, name)
+            if projection.precision == "fp8" and projection.backend == "custom":
+                self.prepared_weights[name] = quantize_weights([projection.weight])
+
+    def clear_fp8_weights(self) -> None:
+        self.prepared_weights = {}
+
+    def _load_from_state_dict(self, *args, **kwargs) -> None:
+        self.clear_fp8_weights()
+        super()._load_from_state_dict(*args, **kwargs)
+
+    def _linear(self, x: Tensor, name: str) -> Tensor:
+        projection = getattr(self, name)
+        x = self._cast(x, projection)
+        if projection.precision == "fp8" and projection.backend == "custom":
+            prepared = self.prepared_weights.get(name) if self.training and torch.is_grad_enabled() else None
+            output = project(x, [projection.weight], prepared)[0]
+            return output if projection.bias is None else output + projection.bias.to(output.dtype)
+        return projection(x)
+
+    def _output(self, output: Tensor) -> Tensor:
+        if (self.training and torch.is_grad_enabled() and self.use_bf16_autocast
+                and output.is_cuda and output.dtype == torch.bfloat16
+                and self.out_proj.precision == "fp8" and self.out_proj.backend == "custom"
+                and not output.transpose(1, 2).is_contiguous()):
+            result = project_output(output, self.out_proj.weight, self.prepared_weights.get("out_proj"))
+            return result if self.out_proj.bias is None else result + self.out_proj.bias.to(result.dtype)
+        output = output.transpose(1, 2).contiguous().view(output.size(0), output.size(2), self.attn_dim)
+        return self._linear(output, "out_proj")
+
+    def _cast(self, x: Tensor, module: nn.Module) -> Tensor:
+        if not self.use_bf16_autocast and self.cast_activations_to_weight_dtype_if_no_autocast and x.dtype != module.weight.dtype:
+            x = x.to(dtype=module.weight.dtype)
+        return x
+
+    def _project(self, x: Tensor, start_pos: int = 0) -> Tuple[Tensor, Tensor, Tensor]:
+        batch_size, seq_len, _ = x.shape
+        query = x
+        if self.q_rank:
+            query = self._linear(query, "q_down_proj")
+            query = self.q_norm(self._cast(query, self.q_norm))
+        query = self._linear(query, "q_proj").view(batch_size, seq_len, self.n_heads, self.head_size).transpose(1, 2)
+        compressed = self._linear(x, "kv_down_proj")
+        latent, rope = compressed.split((self.kv_rank, self.rope_dim), dim=-1)
+        latent = self.kv_norm(self._cast(latent, self.kv_norm))
+        latent = self._cast(latent.to(dtype=compressed.dtype), self.kv_up_proj)
+        rope = rope.unsqueeze(1)
+        if self.rotary is not None:
+            # cached chunks rotate at their absolute positions
+            cos = self.rotary.cos_cached[..., start_pos:start_pos + seq_len, :].to(device=query.device, dtype=query.dtype)
+            sin = self.rotary.sin_cached[..., start_pos:start_pos + seq_len, :].to(device=query.device, dtype=query.dtype)
+            query_content, query_rope = query.split((self.content_dim, self.rope_dim), dim=-1)
+            query_rope, rope = apply_rotation(query_rope, rope, cos, sin)
+            query = torch.cat((query_content, query_rope), dim=-1)
+        return query, latent, rope
+
+    def _gain(self, x: Tensor, scale: Tensor) -> Tensor:
+        square = x.pow(2)
+        norm = square.mean(dim=-1, keepdim=True) if self.qk_norm_type == "rms" else square.sum(dim=-1, keepdim=True)
+        gain = torch.rsqrt(norm + self.qk_eps).to(dtype=x.dtype)
+        return gain * torch.clamp(scale, min=self.qk_scale_min, max=self.qk_scale_max).to(dtype=x.dtype)
+
+    def _expanded(self, query: Tensor, latent: Tensor, rope: Tensor, flex_attn_block_mask: Optional[BlockMask], sdpa_attn_mask: Optional[Tensor]) -> Tuple[Tensor, Tensor]:
+        batch_size, _, seq_len, _ = query.shape
+        key_value = self._linear(latent, "kv_up_proj").view(batch_size, seq_len, self.n_kv_heads, self.content_dim + self.value_dim).transpose(1, 2)
+        key_content, value = key_value.split((self.content_dim, self.value_dim), dim=-1)
+        key = torch.cat((key_content, rope.expand(-1, self.n_kv_heads, -1, -1)), dim=-1)
+        if self.use_qk_norm:
+            query = query * self._gain(query, self.q_scale)
+            key_gain = self._gain(key, self.k_scale)
+            key = key * key_gain
+        else:
+            key_gain = torch.ones_like(key[..., :1])
+        if self.use_flex_attention:
+            output = flex_attention(query, key, value, score_mod=self._score_mod, block_mask=flex_attn_block_mask, scale=self.softmax_scale, enable_gqa=self.n_kv_heads != self.n_heads)
+        else:
+            # equal physical widths keep SDPA eligible for its fused flash backend
+            width = max(self.head_size, self.value_dim)
+            if width != self.head_size:
+                query = F.pad(query, (0, width - self.head_size))
