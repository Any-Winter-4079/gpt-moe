+            score = tl.where(valid, score * 1.4426950408889634, float("-inf"))
+            next_maximum = tl.maximum(maximum, tl.max(score, axis=0))
+            # retain -inf for empty splits so later negative logits remain stable
+            safe_maximum = tl.where(next_maximum == float("-inf"), 0.0, next_maximum)
+            correction = tl.exp2(maximum - safe_maximum)
+            probability = tl.exp2(score - safe_maximum)
+            denominator = denominator * correction + tl.sum(probability, axis=0)
+            acc = acc * correction + tl.sum(probability[:, None] * latent, axis=0)
+            maximum = next_maximum
