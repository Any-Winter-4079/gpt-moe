diff --git a/experiments/check_head.py b/experiments/check_head.py
new file mode 100644
--- /dev/null
+++ b/experiments/check_head.py
@@ -0,0 +1,78 @@
+import argparse
+from pathlib import Path
+import sys
+
+import torch
+from torch.nn import functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from model.linear.fp8.custom.dense import _quantize_activations, project
+
+
+def quantized_reference(x, block_rows):
+    m, k = x.shape
+    padded = F.pad(x.detach().float(), (0, (-k) % 128, 0, (-m) % block_rows))
+    values = padded.reshape(-1, block_rows, padded.shape[1] // 128, 128)
+    amax = values.abs().amax((1, 3), keepdim=True)
+    scale = torch.where(amax == 0, 1.0, torch.exp2(torch.ceil(torch.log2(amax / 448.0))).clamp_min(2.0**-126))
+    return ((values / scale).to(torch.float8_e4m3fn).float() * scale).reshape(padded.shape)[:m, :k]
+
+
+def check(actual, expected, label):
+    assert actual.shape == expected.shape and actual.dtype == expected.dtype
+    assert torch.isfinite(actual).all(), label
+    relative_error = (actual.float() - expected.float()).norm() / expected.float().norm().clamp_min(1e-12)
+    print(f"{label}: relative L2={relative_error.item():.8f}")
+    assert relative_error < .001, (label, relative_error.item())
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--large-offsets", action="store_true", help="also check the real batch-8 gradient shape; requires about 14 GB of free GPU memory")
+args = parser.parse_args()
+assert torch.cuda.is_available() and torch.cuda.get_device_capability() == (12, 0), "this correctness check requires SM120"
+torch.manual_seed(2026)
+torch.set_float32_matmul_precision("highest")
+
+for vocabulary in (256, 50304):
+    for label, operation in (("eager", project), ("compiled", torch.compile(project, fullgraph=True))):
+        torch.compiler.reset()
+        weight = torch.nn.Parameter(torch.randn(vocabulary, 128, device="cuda") * .03)
+        expected_weight = torch.zeros_like(weight)
+        for batch in (4, 8):
+            tokens = torch.randint(vocabulary, (batch, 33), device="cuda")
+            hidden = F.embedding(tokens, weight)
+            hidden.retain_grad()
+            output = operation(hidden, [weight])[0]
+            gradient = torch.randn_like(output) * .01
+            output.backward(gradient)
+            source = hidden.detach().reshape(-1, 128)
+            grad = gradient.reshape(-1, vocabulary)
+            quantized_weight = quantized_reference(weight, 128)
+            expected_output = (quantized_reference(source, 1) @ quantized_weight.t()).bfloat16()
+            expected_hidden = quantized_reference(grad, 1) @ quantized_weight
+            direct_weight = quantized_reference(grad.t(), 1) @ quantized_reference(source.t(), 1).t()
+            expected_weight += direct_weight
+            expected_weight.index_add_(0, tokens.reshape(-1), expected_hidden)
+            check(output.reshape_as(expected_output), expected_output, f"{label} vocab={vocabulary} batch={batch} output")
+            check(hidden.grad, expected_hidden.reshape_as(hidden), f"{label} vocab={vocabulary} batch={batch} input")
+            check(weight.grad, expected_weight, f"{label} vocab={vocabulary} batch={batch} tied weight")
+
+if args.large_offsets:
+    # initialize just four corner tiles distinctly; all other values stay zero
+    gradient = torch.zeros((65536, 50304), device="cuda", dtype=torch.bfloat16)
+    gradient[:128, :128] = .5
+    gradient[:128, -128:] = -2.0
+    gradient[-128:, :128] = 1.0
+    gradient[-128:, -128:] = 4.0
+    row, row_scale, column, column_scale = _quantize_activations([gradient], True)
+    torch.cuda.synchronize()
+    for value in (row[:128, :128], row[-128:, :128], row[-128:, -128:], column[:128, -128:], column[-128:, -128:]):
+        torch.testing.assert_close(value.float(), torch.full(value.shape, 256.0, device="cuda"))
+    torch.testing.assert_close(row[:128, -128:].float(), torch.full((128, 128), -256.0, device="cuda"))
+    torch.testing.assert_close(column[-128:, :128].float(), torch.full((128, 128), -256.0, device="cuda"))
+    assert not row[128:256, 128:256].count_nonzero()
+    assert ((row_scale[-128:, -1] & 255) == 121).all()
+    assert (((column_scale[-1, -128:] >> 24) & 255) == 121).all()
+    print("PASS: 65536 x 50304 activation-gradient quantization and both layouts beyond int32 offsets")
+
+print("PASS: dense FP8 LM-head outputs, input gradients and tied embedding/head gradient accumulation")
