+def _setup_packed_context(ctx: Any, inputs: Tuple, output: Tuple) -> None:
+    x, weight, offsets, order, ctx.top_k, _, ctx.deepgemm = inputs
+    ctx.input_shape = x.shape
+    ctx.input_dtype = x.dtype
+    ctx.weight_dtype = weight.dtype
+    ctx.set_materialize_grads(False)
+    ctx.mark_non_differentiable(*output[1:])
+    ctx.save_for_backward(*output[1:], offsets, order)
+
+
+def _packed_backward(ctx: Any, grad: Tensor, *unused: Tensor) -> Tuple:
+    x_column, x_scale, weight, weight_scale, offsets, order = ctx.saved_tensors
+    grad_packed, grad_weight = _backward_gemms(
+        grad, x_column, x_scale, weight, weight_scale, offsets, ctx.input_dtype, ctx.weight_dtype, ctx.deepgemm,
+    )
+    # each original token receives the gradients from all of its selected experts
+    grad_x = torch.zeros(ctx.input_shape, device=grad.device, dtype=ctx.input_dtype).index_put(
+        (order // ctx.top_k,), grad_packed, accumulate=True,
+    )
+    return grad_x, grad_weight, None, None, None, None, None
+
+
+_packed_forward.register_autograd(_packed_backward, setup_context=_setup_packed_context)
