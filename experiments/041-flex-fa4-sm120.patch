diff --git a/experiments/check_flex_fa4.py b/experiments/check_flex_fa4.py
new file mode 100644
--- /dev/null
+++ b/experiments/check_flex_fa4.py
@@ -0,0 +1,117 @@
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+import sys
+
+import torch
+from torch.nn.attention.flex_attention import create_block_mask, flex_attention
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from flash_attn.cute import interface as fa4_interface
+from model.attention import self_attention as attention_module
+from model.attention.logit_softcapping import generate_tanh_softcap
+
+
+def run(backend, q, k, v, grad, mask, score_mod):
+    inputs = [value.detach().clone().requires_grad_() for value in (q, k, v)]
+
+    def operation(q, k, v):
+        return flex_attention(q, k, v, block_mask=mask, score_mod=score_mod, enable_gqa=q.size(1) != k.size(1), kernel_options={"BACKEND": backend})
+
+    output = torch.compile(operation, fullgraph=True)(*inputs)
+    gradients = torch.autograd.grad(output, inputs, grad)
+    return output.detach(), *(value.detach() for value in gradients)
+
+
+def check(actual, expected, label):
+    for name, value, reference in zip(("output", "dQ", "dK", "dV"), actual, expected):
+        assert value.shape == reference.shape and value.dtype == reference.dtype
+        assert torch.isfinite(value).all(), (label, name)
+        relative_error = (value.float() - reference.float()).norm() / reference.float().norm().clamp_min(1e-12)
+        print(f"{label} {name}: relative L2={relative_error.item():.8f}")
+        assert relative_error < .03, (label, name, relative_error.item())
+        torch.testing.assert_close(value, reference, rtol=.05, atol=.015)
+
+
+def causal(b, h, q, k):
+    return q >= k
+
+
+def exact_swa(b, h, q, k):
+    return (q >= k) & (q - k <= 128)
+
+
+def documents_padding(b, h, q, k):
+    documents = (q // 96) == (k // 96)
+    padding = (q % 17 != 0) & (k % 19 != 0)
+    empty_rows = (b == 1) & (h == 1) & (q >= 128)
+    return (q >= k) & documents & padding & ~empty_rows
+
+
+def noncausal(b, h, q, k):
+    return ((q + k + b + h) % 3 != 0) | (k == 0)
+
+
+def full(b, h, q, k):
+    return q >= 0
+
+
+def empty(b, h, q, k):
+    return q < 0
+
+
+def position_score(score, b, h, q, k):
+    return score * (1.0 + .01 * b + .02 * h + .0001 * q) + .0002 * k
+
+
+def check_project_routing():
+    module = SimpleNamespace(
+        q_proj=torch.nn.Identity(), k_proj=torch.nn.Identity(), v_proj=torch.nn.Identity(), out_proj=torch.nn.Identity(),
+        n_heads=1, n_kv_heads=1, head_size=8, attn_dim=8, rotary=None,
+        use_bf16_autocast=True, cast_activations_to_weight_dtype_if_no_autocast=False,
+        use_qk_norm=False, use_flex_attention=True, flex_fa4_block_size=128, _score_mod=None,
+    )
+    options = []
+
+    def record(q, k, v, **kwargs):
+        options.append(kwargs["kernel_options"])
+        return q
+
+    cases = [(True, 256, torch.bfloat16, 8, {"BACKEND": "FLASH"}), (True, 129, torch.bfloat16, 8, None), (False, 256, torch.bfloat16, 8, None), (False, 129, torch.bfloat16, 8, None), (True, 256, torch.float32, 8, None)]
+    for width in (16, 32, 48, 64, 80, 96, 128, 160, 192, 256, 125):
+        cases.append((True, 256, torch.bfloat16, width, {"BACKEND": "FLASH"} if width <= 160 and width % 8 == 0 else None))
+    with patch.object(attention_module, "flex_attention", record):
+        for training, length, dtype, width, expected in cases:
+            module.training = training
+            module.head_size = module.attn_dim = width
+            output = attention_module.SelfAttention.forward(module, torch.zeros(1, length, width, device="cuda", dtype=dtype))
+            assert output.shape == (1, length, width)
+            assert options[-1] == expected, (training, length, options[-1])
+    print("PASS: actual project routing keeps unsupported heads/dtypes, evaluation and unaligned training on the existing Flex backend")
+
+
+assert torch.cuda.is_available(), "this correctness check requires CUDA"
+assert torch.cuda.get_device_capability() == (12, 0), "this experimental port requires SM120"
+assert getattr(fa4_interface, "SM120_FLEX_SUPPORT", False), "build the performance image with FA4_SM120_FLEX=1"
+torch.manual_seed(2026)
+check_project_routing()
+
+cases = (
+    ("causal", causal, None, 64, 1),
+    ("exact SWA", exact_swa, None, 64, 2),
+    ("documents/padding", documents_padding, generate_tanh_softcap(5.0, "exact"), 64, 1),
+    ("position score", noncausal, position_score, 128, 1),
+    ("full blocks/PTX softcap", full, generate_tanh_softcap(5.0, "ptx"), 64, 1),
+    ("empty rows", empty, generate_tanh_softcap(5.0, "exact"), 128, 2),
+)
+for label, mask_mod, score_mod, width, ratio in cases:
+    q = torch.randn(2, 2, 256, width, device="cuda", dtype=torch.bfloat16)
+    k = torch.randn(2, 2 // ratio, 193, width, device="cuda", dtype=torch.bfloat16)
+    v = torch.randn_like(k)
+    grad = torch.randn_like(q)
+    mask = create_block_mask(mask_mod, 2, 2, 256, 193, device="cuda", BLOCK_SIZE=128)
+    expected = run("TRITON", q, k, v, grad, mask, score_mod)
+    actual = run("FLASH", q, k, v, grad, mask, score_mod)
+    check(actual, expected, label)
+
+print("PASS: Flex FA4 outputs and gradients, sparse/full/empty tiles, document/padding masks, score modifications and GQA")
