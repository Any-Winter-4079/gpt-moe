+def _triangle_num_blocks(M, block_m, block_n, lower_upper):
+    if lower_upper == 0:
+        block_m, block_n = block_n, block_m
+    rows, cols = triton.cdiv(M, block_m), triton.cdiv(M, block_n)
+    if block_m >= block_n:
+        return (block_m // block_n) * (rows - 1) * rows // 2 + cols
+    ratio = block_n // block_m
+    groups, tail = divmod(rows, ratio)
+    return ratio * groups * (groups + 1) // 2 + tail * (groups + 1)
+
+
+@triton.jit
+def _triangle_row_prefix(row, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr):
+    if BLOCK_M >= BLOCK_N:
+        return (BLOCK_M // BLOCK_N) * row * (row + 1) // 2
+    else:
+        ratio: tl.constexpr = BLOCK_N // BLOCK_M
+        group = row // ratio
+        return ratio * group * (group + 1) // 2 + (row % ratio) * (group + 1)
+
