+@triton.jit
+def aX_plus_BX_update_kernel(
+    B_ptr, X_ptr, Weights,
+    M: tl.constexpr, N: tl.constexpr,
+    b_stride_b, b_stride_r, b_stride_c,
+    x_stride_b, x_stride_r, x_stride_c,
+    weight_strides_r: tl.constexpr, weight_strides_c: tl.constexpr,
+    alpha, update_alpha,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    batch = tl.program_id(1)
+    num_pid_m = tl.cdiv(M, BLOCK_M)
+    num_pid_n = tl.cdiv(N, BLOCK_N)
+    pid_m, pid_n = tl.swizzle2d(pid // num_pid_n, pid % num_pid_n, num_pid_m, num_pid_n, 8)
+    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    cols = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    reduction = tl.arange(0, BLOCK_K)
+    B_ptr += batch * b_stride_b
+    X_ptr += batch * x_stride_b
+    accumulator = tl.zeros((BLOCK_M, BLOCK_N), tl.float32)
+    for block in range(tl.cdiv(M, BLOCK_K)):
+        k = block * BLOCK_K + reduction
+        b = tl.load(B_ptr + rows[:, None] * b_stride_r + k[None, :] * b_stride_c,
+                    mask=(rows[:, None] < M) & (k[None, :] < M), other=0.0)
+        x = tl.load(X_ptr + k[:, None] * x_stride_r + cols[None, :] * x_stride_c,
+                    mask=(k[:, None] < M) & (cols[None, :] < N), other=0.0)
+        accumulator = tl.dot(b, x, accumulator)
+    mask = (rows[:, None] < M) & (cols[None, :] < N)
+    original = tl.load(X_ptr + rows[:, None] * x_stride_r + cols[None, :] * x_stride_c,
+                       mask=mask, other=0.0).to(tl.float32)
+    # retain the BF16 projection boundary before updating the master parameters
+    update = tl.fma(alpha, original, accumulator).to(tl.bfloat16).to(tl.float32)
+    for index in tl.static_range(len(Weights)):
+        if batch == index:
+            offsets = rows[:, None] * weight_strides_r[index] + cols[None, :] * weight_strides_c[index]
+            weight = tl.load(Weights[index] + offsets, mask=mask, other=0.0).to(tl.float32)
+            tl.store(Weights[index] + offsets, tl.fma(update_alpha, update, weight), mask=mask)
+
+
+def aX_plus_BX_update(B: Tensor, X: Tensor, weights, update_alpha: float, transpose: bool):
+    M, N = X.shape[-2:]
+    row_dim, col_dim = (-1, -2) if transpose else (-2, -1)
+    # use fixed tiles: autotuning a kernel that mutates parameters would repeat updates
+    aX_plus_BX_update_kernel[(triton.cdiv(M, 64) * triton.cdiv(N, 128), len(weights))](
+        B, X, weights, M, N,
+        B.stride(0), B.stride(-2), B.stride(-1),
+        X.stride(0), X.stride(-2), X.stride(-1),
+        tuple(weight.stride(row_dim) for weight in weights),
+        tuple(weight.stride(col_dim) for weight in weights),
+        polar_express_coeffs[-1][0], update_alpha,
+        BLOCK_M=64, BLOCK_N=128, BLOCK_K=32, num_stages=3, num_warps=4,
+    )
+
