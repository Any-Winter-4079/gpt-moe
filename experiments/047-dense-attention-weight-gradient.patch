@@ -3,6 +3,32 @@
 import torch
 from torch import Tensor
 from torch.library import custom_op
+
+
+@custom_op("gpt_moe::deepgemm_dense_fp8_wgrad", mutates_args=())
+def dense_fp8_wgrad(
+    grad: Tensor, grad_scale: Tensor, x: Tensor, x_scale: Tensor, dtype: torch.dtype,
+) -> Tensor:
+    import deep_gemm
+
+    if torch.cuda.get_device_capability(grad.device) != (12, 0):
+        raise ValueError("DeepGEMM dense FP8 weight gradients require SM120")
+    if dtype not in (torch.float32, torch.bfloat16):
+        raise ValueError("DeepGEMM dense FP8 weight gradients require float32 or bfloat16 weights")
+    out = torch.empty((grad.shape[0], x.shape[0]), device=grad.device, dtype=dtype)
+    # the column quantizers already emit the packed native scales; transpose views select MN-major layout
+    deep_gemm.fp8_gemm_nt(
+        (grad, grad_scale.t()), (x, x_scale.t()), out,
+        recipe=(1, 1, 128), disable_ue8m0_cast=True,
+    )
+    return out
+
+
+@dense_fp8_wgrad.register_fake
+def _fake_dense_fp8_wgrad(
+    grad: Tensor, grad_scale: Tensor, x: Tensor, x_scale: Tensor, dtype: torch.dtype,
+) -> Tensor:
+    return torch.empty((grad.shape[0], x.shape[0]), device=grad.device, dtype=dtype)
 
 
