+def grouped_linear_fp8_relu2(x: Tensor, weight: Tensor, offsets: Tensor, wgrad_backend: str = "triton") -> Tensor:
+    if wgrad_backend not in ("triton", "deepgemm"):
+        raise ValueError(f"unsupported grouped FP8 weight-gradient backend: {wgrad_backend}")
+    if x.dtype != torch.bfloat16:
+        raise ValueError("fused grouped FP8 ReLU2 requires bfloat16 preactivations")
+    save_backward = torch.is_grad_enabled() and (x.requires_grad or weight.requires_grad)
+    return _relu2_forward(x, weight, offsets, save_backward, wgrad_backend == "deepgemm")[0]
