+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// based on NVIDIA CUTLASS example 79c and the SM120 blockscaled collective builder
+// https://github.com/NVIDIA/cutlass/tree/2c85f497547eb441f0fe80bfb0fb2e6f9add1719/examples/79_blackwell_geforce_gemm
+
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <climits>
+
+#include "cute/tensor.hpp"
+#include "cutlass/cutlass.h"
+#include "cutlass/version.h"
+#include "cutlass/detail/sm100_blockscaled_layout.hpp"
+#include "cutlass/epilogue/collective/collective_builder.hpp"
+#include "cutlass/gemm/collective/collective_builder.hpp"
+#include "cutlass/gemm/device/gemm_universal_adapter.h"
+#include "cutlass/gemm/kernel/gemm_universal.hpp"
+
+static_assert(CUTLASS_MAJOR == 4 && CUTLASS_MINOR == 8 && CUTLASS_PATCH == 1,
+              "this experiment requires CUTLASS 4.8.1");
+
+namespace {
+
+using namespace cute;
+using Element = cutlass::mx_float8_t<cutlass::float_e4m3_t>;
+using Layout = cutlass::layout::RowMajor;
+using Tile = Shape<_128, _64, _128>;
+using Cluster = Shape<_1, _1, _1>;
+
+template <class Output>
+struct Projection {
+    static constexpr int Alignment = 128 / cutlass::sizeof_bits<Output>::value;
+    using Epilogue = typename cutlass::epilogue::collective::CollectiveBuilder<
+        cutlass::arch::Sm120, cutlass::arch::OpClassBlockScaledTensorOp,
+        Tile, Cluster, cutlass::epilogue::collective::EpilogueTileAuto,
+        float, float, void, Layout, Alignment, Output, Layout, Alignment,
+        cutlass::epilogue::collective::EpilogueScheduleAuto
+    >::CollectiveOp;
+    // one producer warpgroup feeds TMA buffers while two warpgroups consume them
+    // reserve epilogue space before selecting the number of shared-memory stages
+    using Mainloop = typename cutlass::gemm::collective::CollectiveBuilder<
+        cutlass::arch::Sm120, cutlass::arch::OpClassBlockScaledTensorOp,
+        Element, Layout, 16, Element, cutlass::layout::ColumnMajor, 16,
+        float, Tile, Cluster,
+        cutlass::gemm::collective::StageCountAutoCarveout<static_cast<int>(sizeof(typename Epilogue::SharedStorage))>,
+        cutlass::gemm::KernelTmaWarpSpecializedCooperative
+    >::CollectiveOp;
+    using Kernel = cutlass::gemm::kernel::GemmUniversal<
+        Shape<int, int, int, int>, Mainloop, Epilogue
+    >;
+    using Gemm = cutlass::gemm::device::GemmUniversalAdapter<Kernel>;
+    static_assert(Mainloop::DispatchPolicy::Stages >= 2, "at least two TMA stages are required");
+    static_assert(Kernel::SharedStorageSize <= 101376, "SM120 shared-memory budget exceeded");
+};
+
+void check_status(cutlass::Status status, const char* operation) {
+    TORCH_CHECK(status == cutlass::Status::kSuccess, operation, ": ", cutlass::cutlassGetStatusString(status));
+}
+
+template <class Output>
+void run(const at::Tensor& a, const at::Tensor& b, const at::Tensor& a_scale,
+         const at::Tensor& b_scale, at::Tensor& out, cudaStream_t stream) {
+    using Config = Projection<Output>;
+    using Gemm = typename Config::Gemm;
+    using Kernel = typename Config::Kernel;
+    using ScaleConfig = typename Config::Mainloop::Sm1xxBlkScaledConfig;
+    int m = a.size(0), n = b.size(0), k = a.size(1);
+    typename Kernel::StrideA stride_a{};
+    typename Kernel::StrideB stride_b{};
+    typename Kernel::StrideC stride_c{};
+    typename Kernel::StrideD stride_d{};
+    get<0>(stride_a) = k;
+    get<0>(stride_b) = k;
+    get<0>(stride_c) = n;
+    get<0>(stride_d) = n;
+    auto shape = make_shape(m, n, k, 1);
+    auto layout_a = ScaleConfig::tile_atom_to_shape_SFA(shape);
+    auto layout_b = ScaleConfig::tile_atom_to_shape_SFB(shape);
+    TORCH_CHECK(a_scale.numel() == cosize(layout_a) && b_scale.numel() == cosize(layout_b),
+                "invalid CUTLASS scale storage size");
+    typename Gemm::Arguments arguments{
+        cutlass::gemm::GemmUniversalMode::kGemm, shape,
+        {
+            reinterpret_cast<const cutlass::float_e4m3_t*>(a.data_ptr()), stride_a,
+            reinterpret_cast<const cutlass::float_e4m3_t*>(b.data_ptr()), stride_b,
+            reinterpret_cast<const cutlass::float_ue8m0_t*>(a_scale.data_ptr()), layout_a,
+            reinterpret_cast<const cutlass::float_ue8m0_t*>(b_scale.data_ptr()), layout_b,
+        },
+        {{1.f, 0.f}, nullptr, stride_c, reinterpret_cast<Output*>(out.data_ptr()), stride_d},
+    };
+    arguments.hw_info.device_id = a.get_device();
+    arguments.hw_info.sm_count = at::cuda::getDeviceProperties(a.get_device())->multiProcessorCount;
+    Gemm gemm;
+    check_status(gemm.can_implement(arguments), "CUTLASS can_implement");
+    auto workspace = at::empty(
+        {static_cast<int64_t>(Gemm::get_workspace_size(arguments))}, a.options().dtype(at::kByte));
+    check_status(gemm.initialize(arguments, workspace.data_ptr(), stream), "CUTLASS initialize");
+    check_status(gemm.run(stream), "CUTLASS run");
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void matmul(const at::Tensor& a, const at::Tensor& b, const at::Tensor& a_scale,
+            const at::Tensor& b_scale, at::Tensor out) {
+    TORCH_CHECK(a.is_cuda() && b.device() == a.device() && out.device() == a.device()
+                && a_scale.device() == a.device() && b_scale.device() == a.device(),
+                "CUDA attention operands must be on the same GPU");
+    TORCH_CHECK(a.dim() == 2 && b.dim() == 2 && out.dim() == 2
+                && a.size(1) == b.size(1) && out.size(0) == a.size(0) && out.size(1) == b.size(0),
+                "invalid CUDA attention matrix shapes");
+    TORCH_CHECK(a.scalar_type() == at::kFloat8_e4m3fn && b.scalar_type() == at::kFloat8_e4m3fn
+                && a_scale.scalar_type() == at::kByte && b_scale.scalar_type() == at::kByte,
+                "CUDA attention expects E4M3 operands and UE8M0 scale bytes");
+    TORCH_CHECK(a.is_contiguous() && b.is_contiguous() && out.is_contiguous()
+                && a_scale.is_contiguous() && b_scale.is_contiguous(),
+                "CUDA attention operands must be contiguous");
+    TORCH_CHECK(a.size(0) > 0 && a.size(0) <= INT_MAX && b.size(0) <= INT_MAX
+                && a.size(1) <= INT_MAX && b.size(0) % 128 == 0 && a.size(1) % 128 == 0,
+                "CUDA attention requires nonempty matrices with padded N and K multiples of 128");
+    c10::cuda::CUDAGuard guard(a.device());
+    const auto* properties = at::cuda::getDeviceProperties(a.get_device());
+    TORCH_CHECK(properties->major == 12 && properties->minor == 0, "CUDA attention requires SM120");
+    auto stream = at::cuda::getCurrentCUDAStream(a.get_device());
+    if (out.scalar_type() == at::kBFloat16) {
+        run<cutlass::bfloat16_t>(a, b, a_scale, b_scale, out, stream);
+    } else {
+        TORCH_CHECK(out.scalar_type() == at::kFloat, "CUDA attention output must be BF16 or FP32");
+        run<float>(a, b, a_scale, b_scale, out, stream);
+    }
+}
+
+}  // namespace
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
+    module.def("matmul", &matmul);
+}
