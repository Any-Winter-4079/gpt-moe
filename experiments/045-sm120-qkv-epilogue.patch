+void qkv_matmul(const at::Tensor& a, const at::Tensor& b, const at::Tensor& a_scale,
+                const at::Tensor& b_scale, at::Tensor raw, at::Tensor q, at::Tensor k,
+                at::Tensor q_gain, at::Tensor k_gain, const at::Tensor& q_scale,
