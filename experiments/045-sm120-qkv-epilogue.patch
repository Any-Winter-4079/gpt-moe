+                int seq_len, int heads, float eps, bool rms, float scale_min, float scale_max) {
+    TORCH_CHECK(a.is_cuda() && b.device() == a.device() && raw.device() == a.device()
+                && a_scale.device() == a.device() && b_scale.device() == a.device()
+                && q.device() == a.device() && k.device() == a.device()
+                && q_gain.device() == a.device() && k_gain.device() == a.device()
+                && q_scale.device() == a.device() && k_scale.device() == a.device()
+                && cos.device() == a.device() && sin.device() == a.device(),
+                "QKV epilogue operands must be on the same GPU");
+    TORCH_CHECK(heads > 0 && heads % 2 == 0 && seq_len > 0 && a.size(0) % seq_len == 0
+                && a.dim() == 2 && b.dim() == 2 && a.size(1) == b.size(1)
+                && b.size(0) == 3 * heads * 64 && a.size(1) % 128 == 0,
+                "QKV epilogue requires even head count, head64 and packed QKV weights");
+    TORCH_CHECK(a.scalar_type() == at::kFloat8_e4m3fn && b.scalar_type() == at::kFloat8_e4m3fn
+                && a_scale.scalar_type() == at::kByte && b_scale.scalar_type() == at::kByte
+                && raw.scalar_type() == at::kBFloat16 && q.scalar_type() == at::kBFloat16
+                && k.scalar_type() == at::kBFloat16 && q_gain.scalar_type() == at::kFloat
+                && k_gain.scalar_type() == at::kFloat && q_scale.scalar_type() == at::kFloat
+                && k_scale.scalar_type() == at::kFloat && cos.scalar_type() == at::kFloat
+                && sin.scalar_type() == at::kFloat,
+                "invalid QKV epilogue operand dtype");
+    TORCH_CHECK(a.is_contiguous() && b.is_contiguous() && a_scale.is_contiguous() && b_scale.is_contiguous()
+                && raw.is_contiguous() && q.is_contiguous() && k.is_contiguous()
+                && q_gain.is_contiguous() && k_gain.is_contiguous() && q_scale.is_contiguous()
+                && k_scale.is_contiguous(),
+                "QKV epilogue operands must be contiguous");
+    TORCH_CHECK(raw.dim() == 2 && raw.size(0) == a.size(0) && raw.size(1) == b.size(0)
+                && q.numel() == a.size(0) * heads * 64 && k.sizes() == q.sizes()
+                && q_gain.numel() == a.size(0) * heads && k_gain.numel() == q_gain.numel()
+                && q_scale.numel() == heads && k_scale.numel() == heads
+                && cos.dim() >= 2 && sin.dim() >= 2 && cos.size(-2) >= seq_len && sin.size(-2) >= seq_len
+                && cos.size(-1) == 32 && sin.size(-1) == 32,
+                "invalid QKV epilogue output or rotary shapes");
+    c10::cuda::CUDAGuard guard(a.device());
+    const auto* properties = at::cuda::getDeviceProperties(a.get_device());
+    TORCH_CHECK(properties->major == 12 && properties->minor == 0, "QKV epilogue requires SM120");
+    using Config = QKVProjection;
+    using Kernel = Config::Kernel;
+    using Gemm = Config::Gemm;
+    int m = a.size(0), n = b.size(0), inner = a.size(1);
+    Kernel::StrideA stride_a{};
+    Kernel::StrideB stride_b{};
+    Kernel::StrideC stride_c{};
+    Kernel::StrideD stride_d{};
+    get<0>(stride_a) = inner;
+    get<0>(stride_b) = inner;
+    get<0>(stride_c) = n;
+    get<0>(stride_d) = n;
+    auto shape = make_shape(m, n, inner, 1);
+    using ScaleConfig = Config::Mainloop::Sm1xxBlkScaledConfig;
+    auto layout_a = ScaleConfig::tile_atom_to_shape_SFA(shape);
+    auto layout_b = ScaleConfig::tile_atom_to_shape_SFB(shape);
+    TORCH_CHECK(a_scale.numel() == cosize(layout_a) && b_scale.numel() == cosize(layout_b),
+                "invalid QKV epilogue scale storage size");
+    QKVEpilogue::Arguments epilogue{
+        reinterpret_cast<cutlass::bfloat16_t*>(q.data_ptr()),
+        reinterpret_cast<cutlass::bfloat16_t*>(k.data_ptr()),
+        q_gain.data_ptr<float>(), k_gain.data_ptr<float>(),
+        q_scale.data_ptr<float>(), k_scale.data_ptr<float>(), cos.data_ptr<float>(), sin.data_ptr<float>(),
+        cos.stride(-2), cos.stride(-1), sin.stride(-2), sin.stride(-1),
+        heads, seq_len, eps, scale_min, scale_max, rms,
+    };
+    Gemm::Arguments arguments{
+        cutlass::gemm::GemmUniversalMode::kGemm, shape,
+        {
+            reinterpret_cast<const cutlass::float_e4m3_t*>(a.data_ptr()), stride_a,
+            reinterpret_cast<const cutlass::float_e4m3_t*>(b.data_ptr()), stride_b,
+            reinterpret_cast<const cutlass::float_ue8m0_t*>(a_scale.data_ptr()), layout_a,
+            reinterpret_cast<const cutlass::float_ue8m0_t*>(b_scale.data_ptr()), layout_b,
+        },
+        {epilogue, nullptr, stride_c, reinterpret_cast<cutlass::bfloat16_t*>(raw.data_ptr()), stride_d},
+    };
+    arguments.hw_info.device_id = a.get_device();
+    arguments.hw_info.sm_count = properties->multiProcessorCount;
+    Gemm gemm;
+    auto stream = at::cuda::getCurrentCUDAStream(a.get_device());
+    check_status(gemm.can_implement(arguments), "QKV epilogue can_implement");
+    auto workspace = at::empty(
+        {static_cast<int64_t>(Gemm::get_workspace_size(arguments))}, a.options().dtype(at::kByte));
+    check_status(gemm.initialize(arguments, workspace.data_ptr(), stream), "QKV epilogue initialize");
+    check_status(gemm.run(stream), "QKV epilogue run");
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
 }  // namespace
 
 PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
     module.def("matmul", &matmul);
-}
+    module.def("qkv_matmul", &qkv_matmul);
+}
