+
+#pragma once
+
+#include "cute/tensor.hpp"
+#include "cutlass/epilogue/fusion/sm90_visitor_tma_warpspecialized.hpp"
+
+// use the native SM120 SFVec64 reduction topology from CUTLASS 4.8.1
+// raw BF16 QKV stays in D for backward; normalized Q/K is stored from registers
+struct QKVEpilogue {
+    using BF16 = cutlass::bfloat16_t;
+    struct SharedStorage {
+        alignas(16) float partial[64];
+    };
+    struct Arguments {
+        BF16* q = nullptr;
+        BF16* k = nullptr;
+        float* q_gain = nullptr;
+        float* k_gain = nullptr;
+        const float* q_scale = nullptr;
+        const float* k_scale = nullptr;
+        const float* cos = nullptr;
+        const float* sin = nullptr;
+        int64_t cos_t = 0;
+        int64_t cos_d = 0;
+        int64_t sin_t = 0;
+        int64_t sin_d = 0;
+        int heads = 0;
+        int seq_len = 0;
+        float eps = 0;
+        float scale_min = 0;
+        float scale_max = 0;
+        bool rms = false;
+    };
+    using Params = Arguments;
+    const Params* params = nullptr;
+    float* partial = nullptr;
+
+    template <class Shape>
+    static Params to_underlying_arguments(const Shape&, const Arguments& args, void*) {
+        return args;
+    }
+    template <class Shape>
+    static bool can_implement(const Shape& shape, const Arguments& args) {
+        return cute::get<1>(shape) == 3 * args.heads * 64 && args.heads % 2 == 0
+            && args.seq_len > 0 && cute::get<0>(shape) % args.seq_len == 0;
+    }
+    template <class Shape>
+    static size_t get_workspace_size(const Shape&, const Arguments&) {
+        return 0;
+    }
+    template <class Shape>
+    static cutlass::Status initialize_workspace(const Shape&, const Arguments&, void*, cudaStream_t,
+                                               cutlass::CudaHostAdapter* = nullptr) {
+        return cutlass::Status::kSuccess;
+    }
+    CUTLASS_HOST_DEVICE QKVEpilogue() = default;
+    CUTLASS_HOST_DEVICE QKVEpilogue(const Params& args, const SharedStorage& storage)
+        : params(&args), partial(const_cast<float*>(storage.partial)) {}
+    CUTLASS_DEVICE bool is_producer_load_needed() const { return false; }
+    CUTLASS_DEVICE bool is_C_load_needed() const { return false; }
+    template <class... Args>
+    CUTLASS_DEVICE auto get_producer_load_callbacks(
+        const cutlass::epilogue::fusion::detail::ProducerLoadArgs<Args...>&) {
+        return cutlass::epilogue::fusion::detail::EmptyProducerLoadCallbacks{};
+    }
+
+    template <class Coords>
+    struct Consumer : cutlass::epilogue::fusion::detail::EmptyConsumerStoreCallbacks {
+        Coords coords;
+        const Params* params;
+        float* partial;
+        int thread;
+        int m;
+
+        CUTLASS_DEVICE Consumer(Coords&& coords_, const Params* params_, float* partial_, int thread_, int m_)
+            : coords(cute::move(coords_)), params(params_), partial(partial_), thread(thread_), m(m_) {}
+
+        CUTLASS_DEVICE static float bf16(float value) {
+            return float(cutlass::NumericConverter<BF16, float>{}(value));
+        }
+
+        template <class Accumulator, int Fragment>
+        CUTLASS_DEVICE auto visit(const cutlass::Array<Accumulator, Fragment>& acc, int, int, int) {
+            static_assert(Fragment == 4, "QKV epilogue requires native SM120 four-element fragments");
+            cutlass::Array<float, 4> result;
+            CUTLASS_PRAGMA_UNROLL
+            for (int i = 0; i < 4; ++i) result[i] = bf16(acc[i]);
+            return result;
+        }
+
+        template <class Smem, class Sync, class Values>
+        CUTLASS_DEVICE void reduce(Smem&&, const Sync&, int epi_m, int epi_n, bool, Values raw) {
+            using namespace cute;
+            static_assert(decltype(size<0>(raw))::value == 1);
+            static_assert(decltype(size<0>(coords))::value == 4);
+            static_assert(decltype(size<2>(raw))::value == 2,
+                          "the reduction must contain one complete 64-feature head");
+            int global_head = get<1>(coords(0, 0, 0, epi_m, epi_n)) / 64;
+            if (global_head >= 2 * params->heads) return;
+            bool is_q = global_head < params->heads;
+            int head = global_head % params->heads;
+            float learned = is_q ? params->q_scale[head] : params->k_scale[head];
+            learned = learned < params->scale_min ? params->scale_min : learned;
+            learned = learned > params->scale_max ? params->scale_max : learned;
+            learned = bf16(learned);
+            auto output = is_q ? params->q : params->k;
+            auto gains = is_q ? params->q_gain : params->k_gain;
+            int warp = thread / 32;
+            int quad = thread % 32 / 4;
+            int lane = thread % 4;
+            auto sync = []() {
+                cutlass::arch::NamedBarrier::sync(
+                    256, cutlass::arch::ReservedNamedBarriers::EpilogueBarrier);
+            };
+            Tensor rotated = make_tensor_like(raw);
+            CUTLASS_PRAGMA_UNROLL
+            for (int row = 0; row < size<1>(raw); ++row) {
+                CUTLASS_PRAGMA_UNROLL
+                for (int fragment = 0; fragment < size<2>(raw); ++fragment) {
+                    CUTLASS_PRAGMA_UNROLL
+                    for (int pair = 0; pair < 2; ++pair) {
+                        int i = 2 * pair;
+                        auto position = coords(i, row, fragment, epi_m, epi_n);
+                        int token = get<0>(position) % params->seq_len;
+                        int feature = get<1>(position) % 64;
+                        float cosine = bf16(params->cos[token * params->cos_t + feature / 2 * params->cos_d]);
+                        float sine = bf16(params->sin[token * params->sin_t + feature / 2 * params->sin_d]);
+                        auto source = raw(0, row, fragment);
+                        rotated(0, row, fragment)[i] = bf16(__fsub_rn(
+                            bf16(__fmul_rn(source[i], cosine)), bf16(__fmul_rn(source[i + 1], sine))));
+                        rotated(0, row, fragment)[i + 1] = bf16(__fadd_rn(
+                            bf16(__fmul_rn(source[i], sine)), bf16(__fmul_rn(source[i + 1], cosine))));
+                    }
+                }
+                CUTLASS_PRAGMA_UNROLL
+                for (int pair_row = 0; pair_row < 2; ++pair_row) {
+                    int i = 2 * pair_row;
+                    float sum = 0.f;
+                    CUTLASS_PRAGMA_UNROLL
+                    for (int fragment = 0; fragment < size<2>(raw); ++fragment) {
+                        auto values = rotated(0, row, fragment);
+                        sum = __fadd_rn(sum, __fmul_rn(values[i], values[i]));
+                        sum = __fadd_rn(sum, __fmul_rn(values[i + 1], values[i + 1]));
+                    }
+                    sum = __fadd_rn(sum, __shfl_xor_sync(0xffffffff, sum, 1));
+                    sum = __fadd_rn(sum, __shfl_xor_sync(0xffffffff, sum, 2));
+                    if (lane == 0) partial[warp * 8 + quad] = sum;
+                    sync();
+                    int first_warp = warp % 2;
+                    sum = __fadd_rn(partial[first_warp * 8 + quad], partial[(first_warp + 2) * 8 + quad]);
+                    sum = __fadd_rn(sum, partial[(first_warp + 4) * 8 + quad]);
+                    sum = __fadd_rn(sum, partial[(first_warp + 6) * 8 + quad]);
+                    sync();
+                    float statistic = params->rms ? sum * (1.f / 64.f) : sum;
+                    float gain = rsqrtf(__fadd_rn(statistic, params->eps));
+                    float rounded_gain = bf16(gain);
+                    auto position = coords(i, row, 0, epi_m, epi_n);
+                    int global_row = get<0>(position);
+                    int batch = global_row / params->seq_len;
+                    int token = global_row % params->seq_len;
+                    int64_t row_offset = (int64_t(batch) * params->heads + head) * params->seq_len + token;
+                    if (global_row < m) {
+                        if (lane == 0 && warp < 2) gains[row_offset] = gain;
+                        CUTLASS_PRAGMA_UNROLL
+                        for (int fragment = 0; fragment < size<2>(raw); ++fragment) {
+                            int col = get<1>(coords(i, row, fragment, epi_m, epi_n)) % 64;
+                            auto values = rotated(0, row, fragment);
+                            BF16 first = cutlass::NumericConverter<BF16, float>{}(
+                                __fmul_rn(bf16(__fmul_rn(values[i], rounded_gain)), learned));
+                            BF16 second = cutlass::NumericConverter<BF16, float>{}(
+                                __fmul_rn(bf16(__fmul_rn(values[i + 1], rounded_gain)), learned));
+                            output[row_offset * 64 + col] = first;
+                            output[row_offset * 64 + col + 1] = second;
+                        }
+                    }
+                }
+            }
+        }
+    };
+
+    template <bool ReferenceSrc, class... Args>
+    CUTLASS_DEVICE auto get_consumer_store_callbacks(
+        const cutlass::epilogue::fusion::detail::ConsumerStoreArgs<Args...>& args) {
+        using namespace cute;
+        static_assert(decltype(size(args.tiled_copy))::value == 256);
+        auto [m, n, k, l] = args.problem_shape_mnkl;
+        auto identity = make_identity_tensor(make_shape(m, n, l));
+        auto coords = cutlass::epilogue::fusion::detail::sm90_partition_for_epilogue<ReferenceSrc>(
+            identity, args.tile_shape_mnk, args.tile_coord_mnkl, args.epi_tile, args.tiled_copy, args.thread_idx);
+        return Consumer<decltype(coords)>(cute::move(coords), params, partial, args.thread_idx, m);
+    }
+};
diff --git a/experiments/check_qkv_sm120_epilogue.py b/experiments/check_qkv_sm120_epilogue.py
new file mode 100644
--- /dev/null
+++ b/experiments/check_qkv_sm120_epilogue.py
@@ -0,0 +1,86 @@
+from pathlib import Path
+import sys
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from model.attention.qkv_sm120_epilogue import _forward_projection, project_qkv_norm_rope
+from model.linear.attention_fp8 import _matmul, _quantize_activations, project, quantize_weights
+from model.position.rotary import apply_rotation
+
+
+def reference(x, weights, q_scale, k_scale, cos, sin, eps, rms, minimum, maximum, heads, prepared):
+    q, k, v = [value.view(x.shape[0], x.shape[1], heads, 64).transpose(1, 2)
+               for value in project(x, weights, prepared)]
+    q, k = apply_rotation(q, k, cos.to(q.dtype), sin.to(k.dtype))
+    q_statistic = q.pow(2).mean(-1, keepdim=True) if rms else q.pow(2).sum(-1, keepdim=True)
+    k_statistic = k.pow(2).mean(-1, keepdim=True) if rms else k.pow(2).sum(-1, keepdim=True)
+    q = q * torch.rsqrt(q_statistic + eps).to(q.dtype) * q_scale.clamp(minimum, maximum).to(q.dtype)
+    k = k * torch.rsqrt(k_statistic + eps).to(k.dtype) * k_scale.clamp(minimum, maximum).to(k.dtype)
+    return q, k, v
+
+
+def check(actual, expected, label):
+    assert actual.shape == expected.shape and actual.dtype == expected.dtype
+    assert torch.isfinite(actual).all(), label
+    error = (actual.float() - expected.float()).norm() / expected.float().norm().clamp_min(1e-12)
+    print(f"{label}: relative L2={error.item():.8f}")
+    assert error < .015, (label, error.item())
+
+
+torch.manual_seed(2026)
+torch.set_float32_matmul_precision("highest")
+assert torch.cuda.is_available() and torch.cuda.get_device_capability() == (12, 0), "this correctness check requires SM120"
+
+for label, operation in (("eager", project_qkv_norm_rope), ("compiled", torch.compile(project_qkv_norm_rope, fullgraph=True))):
+    for dtype in (torch.float32, torch.bfloat16):
+        for cached in (False, True):
+            for rms in (False, True):
+                for batch, length, heads, width in ((1, 17, 2, 128), (2, 129, 4, 129)):
+                    torch.compiler.reset()
+                    x = torch.randn(batch, length, width * 2, device="cuda", dtype=dtype)[:, :, ::2].requires_grad_()
+                    weights = [torch.nn.Parameter(torch.randn(heads * 64, width, device="cuda") * .03) for _ in range(3)]
+                    q_scale = torch.nn.Parameter(torch.tensor([-.75, -.5, 1.5, 1.75][:heads], device="cuda").view(1, heads, 1, 1))
+                    k_scale = torch.nn.Parameter(torch.tensor([1.75, 1.5, -.5, -.75][:heads], device="cuda").view(1, heads, 1, 1))
+                    angle = torch.randn(1, 1, length * 2, 32, device="cuda")
+                    cos, sin = angle.cos()[..., ::2, :], angle.sin()[..., ::2, :]
+                    prepared = quantize_weights(weights) if cached else None
+                    args = (x, weights, q_scale, k_scale, cos, sin, 1e-6, rms, -.5, 1.5, heads, prepared)
+                    with torch.no_grad():
+                        packed = prepared if prepared is not None else quantize_weights(weights)
+                        row, row_scale, _, _ = _quantize_activations([x.detach().reshape(-1, width)], False)
+                        raw, processed_q, processed_k, q_gain, k_gain = _forward_projection(
+                            row, packed[0], row_scale, packed[1], q_scale, k_scale, cos, sin,
+                            length, heads, 1e-6, rms, -.5, 1.5,
+                        )
+                        raw_reference = _matmul(row, packed[0], row_scale, packed[1], torch.bfloat16)
+                        torch.testing.assert_close(raw, raw_reference, rtol=0, atol=0)
+                        raw_q, raw_k = [raw[:, start:start + heads * 64].view(batch, length, heads, 64).transpose(1, 2)
+                                        for start in (0, heads * 64)]
+                        rotated_q, rotated_k = apply_rotation(raw_q, raw_k, cos.bfloat16(), sin.bfloat16())
+                        for value, scale, gain, processed in ((rotated_q, q_scale, q_gain, processed_q),
+                                                              (rotated_k, k_scale, k_gain, processed_k)):
+                            square = value.float().pow(2)
+                            statistic = square.mean(-1) if rms else square.sum(-1)
+                            expected_gain = torch.rsqrt(statistic + 1e-6)
+                            torch.testing.assert_close(gain, expected_gain, rtol=1e-6, atol=1e-6)
+                            check(processed, value * expected_gain.bfloat16()[..., None]
+                                  * scale.clamp(-.5, 1.5).bfloat16(), f"{label} epilogue direct output")
+                    with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
+                        actual = operation(*args)
+                        expected = reference(*args)
+                    gradients = [torch.randn_like(value) * .01 for value in actual]
+                    parameters = [x, *weights, q_scale, k_scale]
+                    for output, target in zip(actual, expected):
+                        check(output, target, f"{label} cached={cached} rms={rms} output")
+                    for selected in ((0, 1, 2), (0,)):
+                        actual_grads = torch.autograd.grad([actual[i] for i in selected], parameters,
+                                                           [gradients[i] for i in selected], allow_unused=True, retain_graph=True)
+                        expected_grads = torch.autograd.grad([expected[i] for i in selected], parameters,
+                                                             [gradients[i] for i in selected], allow_unused=True, retain_graph=True)
+                        for name, source, gradient, target in zip(("input", "q weight", "k weight", "v weight", "q scale", "k scale"), parameters, actual_grads, expected_grads):
+                            gradient = torch.zeros_like(source) if gradient is None else gradient
+                            target = torch.zeros_like(source) if target is None else target
+                            check(gradient, target, f"{label} cached={cached} rms={rms} {name}")
+
+print("PASS: SM120 QKV GEMM epilogue raw output, processed Q/K and gains, FP8 backward operands, all parameter gradients, cache reuse and eager/fullgraph compilation")
