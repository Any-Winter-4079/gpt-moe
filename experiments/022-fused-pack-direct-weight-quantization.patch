+def _setup_weights_context(ctx: Any, inputs: Tuple, output: Tuple) -> None:
+    x, weights, offsets, _, ctx.deepgemm, relu2, order, ctx.top_k = inputs
+    ctx.input_shape = x.shape
+    ctx.input_dtype = x.dtype
+    ctx.weight_dtype = weights[0].dtype
+    ctx.set_materialize_grads(False)
+    ctx.mark_non_differentiable(*output[1:])
+    ctx.save_for_backward(*output[1:], offsets, x if relu2 else None, order)
+
+
+def _weights_backward(ctx: Any, grad: Tensor, *unused: Tensor) -> Tuple:
+    x_column, x_scale, weight, weight_scale, offsets, preactivation, order = ctx.saved_tensors
+    grad_x, grad_weight = _backward_gemms(
+        grad, x_column, x_scale, weight, weight_scale, offsets, ctx.input_dtype, ctx.weight_dtype,
+        ctx.deepgemm, preactivation,
+    )
+    if order is not None:
+        grad_x = torch.zeros(ctx.input_shape, device=grad.device, dtype=ctx.input_dtype).index_put(
+            (order // ctx.top_k,), grad_x, accumulate=True,
+        )
+    return grad_x, list(grad_weight.unbind(0)), None, None, None, None, None, None
+
+
+_weights_forward.register_autograd(_weights_backward, setup_context=_setup_weights_context)
+
+
+def grouped_linear_fp8_weights(
+    x: Tensor, weights: List[Tensor], offsets: Tensor, wgrad_backend: str = "triton", relu2: bool = False,
+    order: Optional[Tensor] = None, top_k: int = 1,
+) -> Tensor:
+    if wgrad_backend not in ("triton", "deepgemm"):
+        raise ValueError(f"unsupported grouped FP8 weight-gradient backend: {wgrad_backend}")
+    if relu2 and x.dtype != torch.bfloat16:
+        raise ValueError("fused grouped FP8 ReLU2 requires bfloat16 preactivations")
+    save_backward = torch.is_grad_enabled() and (x.requires_grad or any(weight.requires_grad for weight in weights))
+    return _weights_forward(x, weights, offsets, save_backward, wgrad_backend == "deepgemm", relu2, order, top_k)[0]
+
+
 def grouped_linear_fp8(x: Tensor, weight: Tensor, offsets: Tensor, wgrad_backend: str = "triton") -> Tensor:
     if wgrad_backend not in ("triton", "deepgemm"):
         raise ValueError(f"unsupported grouped FP8 weight-gradient backend: {wgrad_backend}")
